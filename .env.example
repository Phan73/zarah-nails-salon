# ========================================================
# Zarah Nails & Beauty Massey - Environment Configuration
# ========================================================
# To enable real Firebase Authentication (Google OAuth 2.0, Sign in with Apple,
# Passwordless NZ Mobile SMS, Email/Password, and safe account linking):
#
# 1. Create a Firebase project at https://console.firebase.google.com/
# 2. Add a Web App ("Zarah Nails Web")
# 3. Copy the configuration keys below into a new file named `.env` in this directory.
# 4. Under Firebase Console -> Build -> Authentication:
#    - Enable 'Google' provider
#    - Enable 'Apple' provider (configure Apple Developer Services ID & Key)
#    - Enable 'Phone' provider (for real NZ mobile SMS verification)
#    - Enable 'Email/Password' provider
# 5. Under Firebase Console -> Settings -> Authorized Domains:
#    - Add `localhost`
#    - Add `temporary-fast-celesta-lp7dd2z.vercel.app` (or your active Vercel domain)
#    - Add `zarahnailsmassey.co.nz` (production domain)

PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
PUBLIC_FIREBASE_AUTH_DOMAIN=zarah-nails-massey.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=zarah-nails-massey
PUBLIC_FIREBASE_STORAGE_BUCKET=zarah-nails-massey.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google Places API Key (For live auto-updating Google Reviews)
# PUBLIC_GOOGLE_PLACES_API_KEY=AIzaSyYourGooglePlacesApiKeyHere
# PUBLIC_GOOGLE_PLACE_ID=ChIJN1t_tDeuEmsRUsoyG83frY4
