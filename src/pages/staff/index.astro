  // Render Staff Roster & Reassignment
  function renderStaffRosters() {
    const container = document.getElementById('staff-roster-container');
    if (!container) return;

    const activeTechs = activeTeam.filter(t => t.id !== 'any-available');
    container.innerHTML = activeTechs.map(staff => `
      <div class="roster-card" data-staff-id="${staff.id}">
        <div class="roster-card-header">
          <div>
            <h3>${staff.name}</h3>
            <span class="roster-role">${staff.role}</span>
          </div>
          <span class="status-chip active">On Duty Today</span>
        </div>
        <p class="roster-specialties">Specialties: ${staff.specialties.join(', ')}</p>
        <div class="roster-actions">
          <button type="button" class="btn btn-subtle btn-sm btn-mark-away" data-staff-name="${staff.name}" data-staff-id="${staff.id}">
            Mark Away &amp; Reassign Slots
          </button>
        </div>
      </div>
    `).join('');

    document.querySelectorAll('.btn-mark-away').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const name = e.currentTarget.getAttribute('data-staff-name');
        const staffId = e.currentTarget.getAttribute('data-staff-id');
        const appointments = JSON.parse(localStorage.getItem('zarah_appointments') || '[]');
        const affected = appointments.filter(a => a.staffId === staffId && a.status === 'confirmed');

        if (affected.length === 0) {
          alert(`${name} has no booked appointments today that need reassigning.`);
          return;
        }

        if (confirm(`${name} has ${affected.length} booked slots today. Would you like to review and reassign them with automated SMS alerts?`)) {
          document.querySelector('.portal-tab[data-tab-target="tab-calendar"]')?.click();
          document.querySelector(`#staff-calendar-filters .staff-filter-pill[data-staff="${staffId}"]`)?.click();
        }
      });
    });
  }

  // ==========================================
  // CUSTOMER DIRECTORY & 10-DOT LOYALTY CONTROLLER
  // ==========================================
  function renderCustomerDirectory() {
    const container = document.getElementById('customers-directory-container');
    if (!container) return;

    activeCustomers = window.SalonStore ? window.SalonStore.getCustomers(initialCustomers) : [];

    // Filter by search query and active chip
    const filtered = activeCustomers.filter(c => {
      // 1. Search Query
      if (customerSearchQuery) {
        const query = customerSearchQuery.toLowerCase();
        const matchName = (c.name || '').toLowerCase().includes(query);
        const matchPhone = (c.phone || '').replace(/\D/g, '').includes(query.replace(/\D/g, ''));
        const matchEmail = (c.email || '').toLowerCase().includes(query);
        if (!matchName && !matchPhone && !matchEmail) return false;
      }

      // 2. Filter Chip
      if (currentCustomerFilter === 'reward-ready') {
        return (c.completedPoints || 0) >= 10;
      }
      if (currentCustomerFilter === 'has-pending') {
        return (c.pendingPoints || 0) > 0;
      }
      if (currentCustomerFilter === 'regulars') {
        return (c.totalVisits || 0) >= 5;
      }
      return true;
    });

    if (filtered.length === 0) {
      container.innerHTML = `
        <div class="empty-customers-box">
          <p>No customer records found matching your filter.</p>
          <button type="button" class="btn btn-subtle btn-sm" onclick="document.getElementById('btn-open-register-customer').click()">
            + Register New Client
          </button>
        </div>
      `;
      return;
    }

    container.innerHTML = filtered.map(c => {
      const dots = window.SalonStore.calculateDots(c);
      const isRewardReady = dots.isEligibleForFree;

      return `
        <div class="customer-mgmt-card ${isRewardReady ? 'reward-unlocked-card' : ''}" data-cust-id="${c.id}">
          <div class="cust-card-top-row">
            <div class="cust-card-profile">
              <div class="cust-avatar-circle ${isRewardReady ? 'gold' : ''}">${(c.name || 'C').charAt(0).toUpperCase()}</div>
              <div>
                <div class="cust-name-line">
                  <h3 class="cust-name-title">${c.name}</h3>
                  ${isRewardReady ? '<span class="free-reward-badge">🎉 FREE SERVICE UNLOCKED</span>' : ''}
                </div>
                <div class="cust-contact-chips">
                  <a href="tel:${c.phone}" class="cust-chip">📞 ${c.phone || 'No phone'}</a>
                  ${c.email ? `<span class="cust-chip">✉️ ${c.email}</span>` : ''}
                  <span class="cust-chip provider-chip">${c.loginProvider || 'email'}</span>
                </div>
              </div>
            </div>

            <div class="cust-points-status-box">
              <span class="points-pill-label ${isRewardReady ? 'gold' : ''}">
                ${isRewardReady ? '⭐ 10/10 STAMPS COMPLETE' : `${dots.green}/10 Completed • ${dots.orange} Booked`}
              </span>
            </div>
          </div>

          <!-- The 10-Dot Stamp Card Track -->
          <div class="cust-dots-track-wrap">
            ${window.SalonStore.renderDotsHtml(c, false)}
            <div class="cust-dots-caption">
              <span><strong>${dots.green}</strong> Completed (🟢)</span>
              <span><strong>${dots.orange}</strong> Active Booking (🟠)</span>
              <span><strong>${dots.white}</strong> Unearned (⚪)</span>
            </div>
          </div>

          <!-- Stats Grid -->
          <div class="cust-stats-row">
            <div class="cust-stat-col">
              <span class="c-stat-label">Total Visits</span>
              <strong class="c-stat-val">${c.totalVisits || 0}</strong>
            </div>
            <div class="cust-stat-col">
              <span class="c-stat-label">Spend ($NZD)</span>
              <strong class="c-stat-val">$${c.totalSpent || 0}</strong>
            </div>
            <div class="cust-stat-col">
              <span class="c-stat-label">Rewards Redeemed</span>
              <strong class="c-stat-val">${c.rewardsRedeemed || 0}</strong>
            </div>
            <div class="cust-stat-col">
              <span class="c-stat-label">Favorite Tech</span>
              <span class="c-stat-val-sm">${c.preferredStaff || 'Any'}</span>
            </div>
          </div>

          ${c.notes ? `<div class="cust-notes-bar"><em>Client Notes:</em> ${c.notes}</div>` : ''}

          <div class="cust-card-actions">
            ${isRewardReady ? `
              <button type="button" class="btn btn-accent btn-sm btn-claim-reward" data-cust-id="${c.id}">
                🎁 Claim Free Service (Open Overlay)
              </button>
            ` : `
              <button type="button" class="btn btn-primary btn-sm btn-add-point" data-cust-id="${c.id}" data-name="${c.name}">
                +1 Green Point (Log $50+ Visit)
              </button>
            `}
            <button type="button" class="btn btn-subtle btn-sm btn-edit-client" data-cust-id="${c.id}">
              Edit Info
            </button>
          </div>
        </div>
      `;
    }).join('');

    // Attach button events
    document.querySelectorAll('.btn-claim-reward').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const custId = e.currentTarget.getAttribute('data-cust-id');
        const cust = activeCustomers.find(c => c.id === custId);
        if (cust) openLoyaltyRewardOverlay(cust);
      });
    });

    document.querySelectorAll('.btn-add-point').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const custId = e.currentTarget.getAttribute('data-cust-id');
        const cust = activeCustomers.find(c => c.id === custId);
        if (cust) {
          const res = window.SalonStore.completeCustomerVisit(cust.id, 65);
          renderCustomerDirectory();
          if (res && res.isEligibleForFree) {
            openLoyaltyRewardOverlay(res.customer);
          } else {
            alert(`+1 Green Point logged for ${cust.name}! They now have ${res.customer.completedPoints}/10 stamps.`);
          }
        }
      });
    });

    document.querySelectorAll('.btn-edit-client').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const custId = e.currentTarget.getAttribute('data-cust-id');
        const cust = activeCustomers.find(c => c.id === custId);
        if (cust) openRegisterClientModal(cust);
      });
    });
  }

  // Open the 10-Dot Celebration Reward Overlay Modal
  function openLoyaltyRewardOverlay(customer) {
    if (!customer) return;
    selectedCustomerForReward = customer;

    const modal = document.getElementById('loyalty-reward-overlay-modal');
    if (!modal) return;

    document.getElementById('reward-modal-avatar').textContent = (customer.name || 'C').charAt(0).toUpperCase();
    document.getElementById('reward-modal-client-name').textContent = customer.name;
    document.getElementById('reward-modal-client-phone').textContent = customer.phone || 'No phone';
    document.getElementById('reward-modal-client-email').textContent = customer.email || 'No email registered';

    const dotsTrackEl = document.getElementById('reward-modal-dots-track');
    if (dotsTrackEl) {
      dotsTrackEl.innerHTML = window.SalonStore.renderDotsHtml(customer, false);
    }

    modal.style.display = 'flex';
  }

  // Open Register / Add Visit Modal
  function openRegisterClientModal(existingCust) {
    const modal = document.getElementById('register-client-modal');
    const form = document.getElementById('register-client-form');
    const title = document.getElementById('reg-client-modal-title');
    if (!modal || !form) return;

    if (existingCust) {
      title.textContent = `Edit Client: ${existingCust.name}`;
      document.getElementById('rc-customer-id').value = existingCust.id;
      document.getElementById('rc-name').value = existingCust.name || '';
      document.getElementById('rc-phone').value = existingCust.phone || '';
      document.getElementById('rc-email').value = existingCust.email || '';
      document.getElementById('rc-service').value = existingCust.favoriteService || '';
      document.getElementById('rc-notes').value = existingCust.notes || '';
    } else {
      title.textContent = 'Register Walk-In Client / Add Visit Point';
      form.reset();
      document.getElementById('rc-customer-id').value = '';
      document.getElementById('rc-spend').value = '65';
    }

    modal.style.display = 'flex';
  }

  // Setup Loyalty Event Listeners
  function setupLoyaltyEventListeners() {
    // Search input
    const searchInput = document.getElementById('customer-search-input');
    searchInput?.addEventListener('input', (e) => {
      customerSearchQuery = e.target.value;
      renderCustomerDirectory();
    });

    // Filter chips
    document.querySelectorAll('#customer-filter-chips .cust-filter-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('#customer-filter-chips .cust-filter-chip').forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        currentCustomerFilter = chip.getAttribute('data-filter') || 'all';
        renderCustomerDirectory();
      });
    });

    // Open Register Client Modal Button
    document.getElementById('btn-open-register-customer')?.addEventListener('click', () => {
      openRegisterClientModal(null);
    });

    // Close Register Client Modal
    document.getElementById('btn-close-register-client')?.addEventListener('click', () => {
      document.getElementById('register-client-modal').style.display = 'none';
    });
    document.getElementById('btn-cancel-register-client')?.addEventListener('click', () => {
      document.getElementById('register-client-modal').style.display = 'none';
    });

    // Save Register Client Form
    document.getElementById('register-client-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const custId = document.getElementById('rc-customer-id').value;
      const name = document.getElementById('rc-name').value.trim();
      const phone = document.getElementById('rc-phone').value.trim();
      const email = document.getElementById('rc-email').value.trim();
      const service = document.getElementById('rc-service').value.trim();
      const spend = parseFloat(document.getElementById('rc-spend').value) || 50;
      const action = document.getElementById('rc-action').value;
      const notes = document.getElementById('rc-notes').value.trim();

      let cust = custId ? window.SalonStore.findCustomer(custId) : null;
      if (!cust) {
        cust = window.SalonStore.addOrUpdateCustomer({
          name: name,
          phone: phone,
          email: email,
          favoriteService: service,
          notes: notes,
          loginProvider: 'phone',
          completedPoints: 0,
          pendingPoints: 0,
          totalSpent: 0,
          totalVisits: 0
        });
      } else {
        cust.name = name;
        cust.phone = phone;
        cust.email = email;
        cust.favoriteService = service;
        cust.notes = notes;
        window.SalonStore.addOrUpdateCustomer(cust);
      }

      document.getElementById('register-client-modal').style.display = 'none';

      if (action === 'add-point') {
        const res = window.SalonStore.completeCustomerVisit(cust.id, spend);
        renderCustomerDirectory();
        if (res && res.isEligibleForFree) {
          openLoyaltyRewardOverlay(res.customer);
        } else {
          alert(`Visit logged! ${name} now has ${res.customer.completedPoints}/10 stamps.`);
        }
      } else {
        renderCustomerDirectory();
        alert(`Client details saved for ${name}.`);
      }
    });

    // Celebration Overlay: Close Button
    document.getElementById('btn-close-reward-overlay')?.addEventListener('click', () => {
      document.getElementById('loyalty-reward-overlay-modal').style.display = 'none';
    });

    // Celebration Overlay: Redeem Free Service Button
    document.getElementById('btn-redeem-free-service-now')?.addEventListener('click', () => {
      if (!selectedCustomerForReward) return;
      const updated = window.SalonStore.redeemReward(selectedCustomerForReward.id);
      document.getElementById('loyalty-reward-overlay-modal').style.display = 'none';
      renderCustomerDirectory();
      alert(`🎉 FREE SERVICE REDEEMED!\n\n${selectedCustomerForReward.name}'s complimentary treatment has been claimed at front desk. Their stamp card has been reset to 0 green dots for their next 10-visit reward cycle!`);
    });
  }

