  function toggleComplete(id) {
    if (!id) return;
    const appointments = JSON.parse(localStorage.getItem('zarah_appointments') || '[]');
    const target = appointments.find(a => a.id === id);
    if (target) {
      const willBeCompleted = target.status !== 'completed';
      target.status = willBeCompleted ? 'completed' : 'confirmed';
      localStorage.setItem('zarah_appointments', JSON.stringify(appointments));
      renderAppointments();

      // Automatic Loyalty Dot Transition: Orange (Temporary Booked) -> Green (Completed at Salon)
      if (willBeCompleted && window.SalonStore) {
        const identifier = target.clientPhone || target.clientEmail || target.clientName;
        const res = window.SalonStore.completeCustomerVisit(identifier, target.price);
        renderCustomerDirectory();

        if (res && res.isEligibleForFree) {
          // Trigger the 10-Dot Free Service Celebration Overlay Window!
          setTimeout(() => {
            openLoyaltyRewardOverlay(res.customer);
          }, 300);
        }
      }
    }
  }

  function cancelBooking(id) {
    if (!id) return;
    if (confirm('Are you sure you want to cancel this booking? This will remove the slot from the schedule.')) {
      const appointments = JSON.parse(localStorage.getItem('zarah_appointments') || '[]');
      const updated = appointments.filter(a => a.id !== id);
      localStorage.setItem('zarah_appointments', JSON.stringify(updated));
      renderAppointments();
    }
  }

