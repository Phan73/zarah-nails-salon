  // ==========================================
  // GOOGLE REVIEWS MANAGER (Admin Only)
  // ==========================================
  function renderAdminGoogleReviews() {
    var tbody = document.getElementById('admin-reviews-tbody');
    if (!tbody) return;

    var reviews = window.SalonStore
      ? window.SalonStore.getGoogleReviews(initialGoogleReviews)
      : initialGoogleReviews;

    var valid = reviews
      .filter(function(r) { return (parseFloat(r.rating) || 5) >= 4; })
      .sort(function(a, b) { return (b.timestamp || 0) - (a.timestamp || 0); });

    var countEl = document.getElementById('admin-google-count');
    if (countEl) countEl.textContent = valid.length;

    var avgEl = document.getElementById('admin-google-avg-score');
    if (avgEl && valid.length > 0) {
      var sum = valid.reduce(function(acc, r) { return acc + (parseFloat(r.rating) || 5); }, 0);
      avgEl.textContent = (sum / valid.length).toFixed(1);
    }

    if (valid.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-muted);">No 4+ star Google reviews available.</td></tr>';
      return;
    }

    tbody.innerHTML = valid.map(function(rev) {
      var starGold = '★'.repeat(rev.rating) + '☆'.repeat(5 - rev.rating);
      var avatar = rev.profile_photo_url || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(rev.author_name) + '&background=C48B71&color=fff&size=60');
      var dateLabel = rev.relative_time_description || 'Recently';
      var serviceLabel = rev.service || 'Nail Treatment';

      return [
        '<tr>',
          '<td>',
            '<div style="display: flex; align-items: center; gap: 0.75rem;">',
              '<img src="' + avatar + '" alt="" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;" />',
              '<strong>' + rev.author_name + '</strong>',
            '</div>',
          '</td>',
          '<td>',
            '<span style="color: #D4AF37; letter-spacing: 0.1em; font-weight: 600;">' + starGold + '</span>',
            '<span style="font-size: 0.8rem; color: var(--text-muted); margin-left: 0.35rem;">(' + rev.rating + '.0)</span>',
          '</td>',
          '<td><span class="service-pill" style="display: inline-block; padding: 0.2rem 0.5rem; background: var(--bg-stone); border-radius: 12px; font-size: 0.8rem;">' + serviceLabel + '</span></td>',
          '<td><span style="font-size: 0.85rem; color: var(--text-muted);">' + dateLabel + '</span></td>',
          '<td style="max-width: 280px; font-size: 0.85rem; font-style: italic; color: var(--text-espresso); line-height: 1.4;">',
            '"' + rev.text + '"',
          '</td>',
          '<td>',
            '<span style="display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.75rem; color: #3D6A52; font-weight: 600;">',
              '✓ Google Verified',
            '</span>',
          '</td>',
          '<td>',
            '<div style="display: flex; gap: 0.5rem;">',
              '<a href="https://www.google.com/search?q=zara+nail+massey" target="_blank" rel="noopener noreferrer" class="btn btn-subtle btn-sm" title="View listing on Google">View</a>',
              '<button type="button" class="btn btn-subtle btn-sm btn-delete-google-review" data-id="' + rev.id + '" style="color: #C53030;" title="Remove this review from site">Hide</button>',
            '</div>',
          '</td>',
        '</tr>'
      ].join('');
    }).join('');
  }

  function setupGoogleReviewsListeners() {
    var addBtn = document.getElementById('btn-add-google-review');
    var modal = document.getElementById('google-review-modal');
    var closeBtn = document.getElementById('btn-close-google-review-modal');
    var cancelBtn = document.getElementById('btn-cancel-google-review');
    var form = document.getElementById('google-review-form');

    if (addBtn && modal) {
      addBtn.addEventListener('click', function() {
        if (form) form.reset();
        document.getElementById('grev-id').value = '';
        document.getElementById('grev-modal-title').textContent = 'Add Verified Google Review';
        modal.style.display = 'flex';
      });
    }

    if (closeBtn && modal) {
      closeBtn.addEventListener('click', function() { modal.style.display = 'none'; });
    }

    if (cancelBtn && modal) {
      cancelBtn.addEventListener('click', function() { modal.style.display = 'none'; });
    }

    if (form && modal) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var id = document.getElementById('grev-id').value;
        var author = document.getElementById('grev-author').value.trim();
        var rating = parseFloat(document.getElementById('grev-rating').value) || 5;
        var service = document.getElementById('grev-service').value.trim() || 'Nail Treatment';
        var timeDesc = document.getElementById('grev-time').value.trim() || 'Recently';
        var text = document.getElementById('grev-text').value.trim();

        if (!author || !text) {
          alert('Please enter reviewer name and review content.');
          return;
        }

        if (rating < 4) {
          alert('Per salon quality standard, only 4-star and 5-star reviews can be featured.');
          return;
        }

        window.SalonStore.addGoogleReview({
          id: id || undefined,
          author_name: author,
          rating: rating,
          service: service,
          relative_time_description: timeDesc,
          text: text,
          timestamp: Date.now()
        });

        alert('Google review by ' + author + ' has been saved and published to the website!');
        modal.style.display = 'none';
        renderAdminGoogleReviews();
      });
    }

    // Delete / Hide review listener
    var tbody = document.getElementById('admin-reviews-tbody');
    if (tbody) {
      tbody.addEventListener('click', function(e) {
        var btn = e.target.closest('.btn-delete-google-review');
        if (!btn) return;
        var id = btn.getAttribute('data-id');
        if (!id) return;
        if (confirm('Are you sure you want to hide/remove this review from the public website?')) {
          window.SalonStore.deleteGoogleReview(id);
          renderAdminGoogleReviews();
        }
      });
    }

    // Reset to defaults
    var resetBtn = document.getElementById('btn-reset-google-reviews');
    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        if (confirm('Reset Google Reviews back to real verified defaults? This will restore original 4★ & 5★ reviews.')) {
          window.SalonStore.resetGoogleReviews(initialGoogleReviews);
          renderAdminGoogleReviews();
          alert('Reviews reset to official Google Business listing defaults.');
        }
      });
    }

    // Copy SMS Review Request button
    var copyBtn = document.getElementById('btn-copy-review-invite');
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        var smsText = 'Hi from Zarah Nails & Beauty Massey! Thank you for visiting our salon today. If you enjoyed your treatment, please take 30 seconds to leave us a 5-star Google review: https://www.google.com/search?q=zara+nail+massey Thank you for supporting our local Auckland studio! 💅✨';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(smsText).then(function() {
            alert('Review request SMS message copied to clipboard!\n\nYou can now paste and send this via text/WhatsApp to your clients.');
          }).catch(function() {
            prompt('Copy this SMS review request for your client:', smsText);
          });
        } else {
          prompt('Copy this SMS review request for your client:', smsText);
        }
      });
    }
  }

  // Export Bookings
  document.getElementById('btn-export-data')?.addEventListener('click', () => {
    const appointments = JSON.parse(localStorage.getItem('zarah_appointments') || '[]');
    let csv = 'Reference,Client,Phone,Service,Price,Technician,Date,Time,Status,Source\n';
    appointments.forEach(a => {
      csv += `"${a.refCode}","${a.clientName}","${a.clientPhone}","${a.serviceName}","${a.price}","${a.staffName}","${a.date}","${a.time}","${a.status}","${a.source}"\n`;
    });
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `zarah-schedule-${new Date().toISOString().split('T')[0]}.csv`;
    link.click();
    URL.revokeObjectURL(url);
  });
</script>

