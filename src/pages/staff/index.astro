    });

    document.getElementById('staff-account-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const id = document.getElementById('sa-id').value;
      const select = document.getElementById('sa-staff-select');
      const opt = select.options[select.selectedIndex];
      const staffName = opt.getAttribute('data-name') || opt.text;
      const staffId = select.value;
      const username = document.getElementById('sa-username').value.trim();
      const password = document.getElementById('sa-password').value.trim();
      const role = document.getElementById('sa-role').value;

      if (!username || !password) {
        alert('Please provide both username and password.');
        return;
      }

      window.SalonStore.addOrUpdateStaffAccount({
        id: id || undefined,
        staffId: staffId,
        name: staffName,
        username: username,
        password: password,
        role: role
