  // 1-Click Convert Directly: Schedules appointment, awards 1 Orange Dot, and clears from inbox
  function convertMessageDirectly(msgId) {
    let messages = [];
    try {
      messages = JSON.parse(localStorage.getItem('zarah_messages') || '[]');
    } catch (e) {}

    const targetMsg = messages.find(m => m.id === msgId);
    if (!targetMsg) {
      alert('Inquiry not found or already converted.');
      return;
    }

    // Determine appropriate service and pricing based on message content
    const text = (targetMsg.message || '').toLowerCase();
    let serviceName = 'Signature Gel Manicure';
    let servicePrice = '$55 NZD';
    let serviceDur = '45 mins';

    if (text.includes('ombre') || text.includes('art') || text.includes('chrome')) {
      serviceName = 'Custom Nail Art Set';
      servicePrice = '$75 NZD';
      serviceDur = '60 mins';
    } else if (text.includes('pedicure') || text.includes('spa')) {
      serviceName = 'Deluxe Spa Pedicure';
      servicePrice = '$75 NZD';
      serviceDur = '60 mins';
    } else if (text.includes('biab') || text.includes('builder')) {
      serviceName = 'BIAB Builder Gel Overlay';
      servicePrice = '$70 NZD';
      serviceDur = '60 mins';
    }

    const todayStr = new Date().toISOString().split('T')[0];
    const defaultTime = '2:00 PM';
    const assignedStaff = activeTeam.find(t => t.id !== 'any-available') || { name: 'Chloe', id: 'chloe' };

    // 1. Create Appointment
    const newApp = {
      id: 'app-fb-' + Date.now(),
      refCode: 'ZN-' + Math.floor(1000 + Math.random() * 9000),
      clientName: targetMsg.senderName,
      clientPhone: targetMsg.senderPhone || '',
      clientEmail: targetMsg.senderEmail || '',
      serviceName: serviceName,
      price: servicePrice,
      duration: serviceDur,
      staffName: assignedStaff.name,
      staffId: assignedStaff.id,
      date: todayStr,
      time: defaultTime,
      status: 'confirmed',
      source: targetMsg.source || 'Facebook Message',
      clientNotes: `Converted from Facebook: "${targetMsg.message}"`
    };

    const appointments = JSON.parse(localStorage.getItem('zarah_appointments') || '[]');
    appointments.unshift(newApp);
    localStorage.setItem('zarah_appointments', JSON.stringify(appointments));

    // 2. Automatically register into 10-Dot Loyalty Point System with 1 Pending Orange Dot (🟠)
    let custRecord = null;
    if (window.SalonStore) {
      custRecord = window.SalonStore.registerCustomerBooking({
        name: targetMsg.senderName,
        phone: targetMsg.senderPhone || '',
        email: targetMsg.senderEmail || '',
        serviceName: serviceName,
        notes: targetMsg.message,
        source: targetMsg.source || 'Facebook Message'
      });
    }

    // 3. Remove message from inbox
    const updatedMessages = messages.filter(m => m.id !== msgId);
    localStorage.setItem('zarah_messages', JSON.stringify(updatedMessages));

    // 4. Update UI
    renderAppointments();
    renderMessages();
    renderCustomerDirectory();

    // 5. Friendly confirmation alert
    const dotsInfo = custRecord && window.SalonStore ? window.SalonStore.calculateDots(custRecord) : null;
    alert(
      `⚡ 1-CLICK CONVERSION COMPLETE!\n\n` +
      `• Client: ${targetMsg.senderName}\n` +
      `• Scheduled: ${serviceName} on ${todayStr} at ${defaultTime}\n` +
      `• Assigned Staff: ${assignedStaff.name}\n\n` +
      `🌟 10-Dot Loyalty Program Updated:\n` +
      `1 Orange Pending Stamp (🟠) has been credited to ${targetMsg.senderName}'s account!\n` +
      (dotsInfo ? `Status: ${dotsInfo.green} Completed (🟢) | ${dotsInfo.orange} Pending (🟠) | ${dotsInfo.white} Empty (⚪)\n\n` : '\n') +
      `You can view their active stamp card under "🌟 Customers & 10-Dot Loyalty".`
    );
  }

