---
import StaffLayout from '../../layouts/StaffLayout.astro';
import servicesData from '../../data/services.json';
import teamData from '../../data/team.json';
import galleryData from '../../data/gallery.json';
import salonInfo from '../../data/salon-info.json';
import customersData from '../../data/customers.json';
import googleReviewsData from '../../data/google-reviews.json';

const activeStaff = teamData.filter(t => t.id !== 'any-available');
const allServices = servicesData.flatMap(cat => cat.items);
---

<StaffLayout title="Salon Staff & Management Workspace | Zarah Nails & Beauty">
  <!-- 1. INSTANT AUTH VERIFICATION (0-Second Login & Direct Access) -->
  <script is:inline>
    (function() {
      try {
        var user = null;
        var stored = localStorage.getItem('zarah_logged_in_user');
        if (stored) user = JSON.parse(stored);
        var staffAuth = sessionStorage.getItem('zarah_staff_auth') === 'true';
        var hasValidRole = staffAuth || (user && (user.role === 'admin' || user.role === 'staff'));

        if (!hasValidRole) {
          window.location.replace('/?openLogin=1&redirect=' + encodeURIComponent(window.location.pathname));
        }
      } catch (e) {}
    })();
  </script>

  <!-- 2. AUTHENTICATED WORKSPACE (Rendered Directly) -->
  <div id="staff-portal-content" class="staff-workspace">
    <!-- Top Action Toolbar -->
    <div class="staff-toolbar">
      <div class="toolbar-left">
        <div class="active-role-indicator" id="active-role-tag">
          <span class="role-icon">👤</span>
          <span class="role-name">Role: Normal Staff</span>
        </div>
        <h1>Salon Operations &amp; Management</h1>
        <p class="toolbar-sub">Shop 12, 3 Red Hills Road, Massey • Auckland</p>
      </div>

      <div class="toolbar-right">
        <button type="button" class="btn btn-accent" id="btn-open-walkin-modal">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Log Walk-in / Phone Booking</span>
        </button>
        <button type="button" class="btn btn-subtle" id="btn-export-data">
          <span>Export Bookings (CSV)</span>
        </button>
      </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="stats-overview-grid">
      <div class="stat-card">
        <span class="stat-label">Today's Appointments</span>
        <span class="stat-value" id="stat-today-count">4</span>
        <span class="stat-meta">Active on calendar</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">On-Duty Technicians</span>
        <span class="stat-value" id="stat-active-staff-count">3</span>
        <span class="stat-meta" id="stat-staff-names">Zarah • Priya • Chloe</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Facebook &amp; Social Inquiries</span>
        <span class="stat-value" id="stat-msg-count" style="color: var(--accent-rose);">2 New</span>
        <span class="stat-meta">Ready for 1-click booking</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Catalog Services</span>
        <span class="stat-value" id="stat-services-count">{allServices.length}</span>
        <span class="stat-meta">Active menu items</span>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="portal-tab-bar">
      <!-- Staff Tabs -->
      <button type="button" class="portal-tab active" data-tab-target="tab-calendar">
        📅 Appointments &amp; Calendar
      </button>
      <button type="button" class="portal-tab" data-tab-target="tab-messages">
        💬 Facebook &amp; Social Inbox
        <span class="tab-badge" id="inbox-badge-count">2</span>
      </button>
      <button type="button" class="portal-tab" data-tab-target="tab-staff-shifts">
        👥 Staff Schedules &amp; Reassignment
      </button>
      <button type="button" class="portal-tab" data-tab-target="tab-customers-loyalty" id="tab-btn-loyalty">
        🌟 Customers &amp; 10-Dot Loyalty
      </button>

      <!-- Admin Only Tabs (Protected) -->
      <button type="button" class="portal-tab admin-locked" data-tab-target="tab-admin-services" id="tab-btn-services">
        🔒 Services &amp; Pricing Editor
      </button>
      <button type="button" class="portal-tab admin-locked" data-tab-target="tab-admin-gallery" id="tab-btn-gallery">
        🔒 Gallery Photo Manager
      </button>
      <button type="button" class="portal-tab admin-locked" data-tab-target="tab-admin-team" id="tab-btn-team">
        🔒 Staff Roster Manager
      </button>
      <button type="button" class="portal-tab admin-locked" data-tab-target="tab-admin-reviews" id="tab-btn-reviews">
        🔒 Google Reviews Manager
      </button>
    </div>

    <!-- ==========================================
         TAB 1: CALENDAR & APPOINTMENTS (All Staff)
         ========================================== -->
    <section class="tab-pane active" id="tab-calendar">
      <div class="calendar-header-filter">
        <div class="filter-group">
          <label class="filter-label">Filter by Staff Member:</label>
          <div class="staff-filter-pills" id="staff-calendar-filters">
            <button type="button" class="staff-filter-pill active" data-staff="all">All Technicians</button>
            {activeStaff.map(s => (
              <button type="button" class="staff-filter-pill" data-staff={s.id}>{s.name}</button>
            ))}
          </div>
        </div>

        <div class="date-jump-box">
          <label class="filter-label">Date:</label>
          <input type="date" id="calendar-date-picker" class="staff-date-input" />
        </div>
      </div>

      <div class="appointments-list-container" id="appointments-container">
        <!-- Rendered dynamically from localStorage -->
      </div>
    </section>

    <!-- ==========================================
         TAB 2: FACEBOOK & SOCIAL INBOX (All Staff)
         ========================================== -->
    <section class="tab-pane" id="tab-messages">
      <div class="inbox-header-box">
        <div>
          <h2>Facebook Messages &amp; Online Inquiries</h2>
          <p class="inbox-sub">
            Inquiries sent from your Facebook Page (<strong>@zarahnailsandbeauty</strong>) or the website contact form appear here. Click <strong>"1-Click Convert to Booking"</strong> to turn any message into a scheduled appointment.
          </p>
        </div>
        <button type="button" class="btn btn-subtle btn-sm" id="btn-refresh-messages">
          Refresh Inquiries
        </button>
      </div>

      <div class="messages-list" id="messages-container">
        <!-- Rendered dynamically from localStorage -->
      </div>
    </section>

    <!-- ==========================================
         TAB 3: STAFF SHIFTS & REASSIGNMENT (All Staff)
         ========================================== -->
    <section class="tab-pane" id="tab-staff-shifts">
      <div class="shifts-panel">
        <h2>Active Staff Roster &amp; Absence Cover</h2>
        <p class="shifts-sub">
          If a staff member cannot make it in on the day, select their name below to reassign their slots to another technician. The client will automatically receive an SMS alert notification.
        </p>

        <div class="staff-roster-grid" id="staff-roster-container">
          <!-- Populated from store -->
        </div>
      </div>
    </section>

    <!-- ==========================================
         TAB 3.5: CUSTOMER DIRECTORY & 10-DOT LOYALTY (All Staff)
         ========================================== -->
    <section class="tab-pane" id="tab-customers-loyalty">
      <div class="loyalty-mgmt-panel">
        <div class="loyalty-mgmt-header">
          <div>
            <h2>Customer Directory &amp; 10-Dot Loyalty Tracker</h2>
            <p class="loyalty-mgmt-sub">
              Every completed service or minimum spend ($50 NZD) earns 1 point.
              <span class="legend-chip"><span class="loyalty-dot dot-white"></span> White = Unearned</span>
              <span class="legend-chip"><span class="loyalty-dot dot-orange"></span> Orange = Active Booking (Temporary)</span>
              <span class="legend-chip"><span class="loyalty-dot dot-green"></span> Green = Completed at Salon</span>.
              Completing <strong>10 Green Dots</strong> unlocks a free salon service!
            </p>
          </div>
          <button type="button" class="btn btn-primary" id="btn-open-register-customer">
            + Register Walk-In Client / Log Visit
          </button>
        </div>

        <!-- Directory Search & Filter Controls -->
        <div class="customer-search-filter-bar">
          <div class="search-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="customer-search-input" placeholder="Search by name, NZ phone (e.g. 021 123 4567), or email..." class="search-field" />
          </div>

          <div class="customer-filter-chips" id="customer-filter-chips">
            <button type="button" class="cust-filter-chip active" data-filter="all">All Clients</button>
            <button type="button" class="cust-filter-chip highlight-gold" data-filter="reward-ready">🎁 Free Service Ready (10 🟢)</button>
            <button type="button" class="cust-filter-chip" data-filter="has-pending">🟠 Has Bookings</button>
            <button type="button" class="cust-filter-chip" data-filter="regulars">💎 Regulars (5+ Visits)</button>
          </div>
        </div>

        <!-- Customers Grid / List -->
        <div class="customers-directory-grid" id="customers-directory-container">
          <!-- Populated dynamically from window.SalonStore.getCustomers() -->
        </div>
      </div>
    </section>
    <section class="tab-pane" id="tab-admin-services">
      <div class="admin-panel-card">
        <div class="admin-panel-header">
          <div>
            <h2>Services &amp; Pricing Management</h2>
            <p class="admin-panel-sub">
              Easily update prices, change service durations, or add new treatments without touching any code. Changes appear live on the public menu instantly.
            </p>
          </div>
          <button type="button" class="btn btn-primary" id="btn-add-new-service">
            + Add New Service
          </button>
        </div>

        <div class="admin-services-list" id="admin-services-container">
          <!-- Populated dynamically -->
        </div>
      </div>
    </section>

    <!-- ==========================================
         TAB 5: ADMIN — GALLERY PHOTO MANAGER (Admin Only)
         ========================================== -->
    <section class="tab-pane" id="tab-admin-gallery">
      <div class="admin-panel-card">
        <div class="admin-panel-header">
          <div>
            <h2>Nail Art Lookbook &amp; Photo Manager</h2>
            <p class="admin-panel-sub">
              Upload customer photos directly from your phone/PC, or auto-generate custom nail styles, colors &amp; artwork from text prompts.
            </p>
          </div>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <button type="button" class="btn btn-accent" id="btn-open-prompt-studio">
              ✨ Auto-Generate from Prompt
            </button>
            <button type="button" class="btn btn-primary" id="btn-add-gallery-item">
              📷 Upload Photo Look
            </button>
          </div>
        </div>

        <div class="admin-gallery-grid" id="admin-gallery-container">
          <!-- Populated dynamically -->
        </div>
      </div>
    </section>

    <!-- ==========================================
         TAB 6: ADMIN — STAFF ROSTER MANAGER (Admin Only)
         ========================================== -->
    <section class="tab-pane" id="tab-admin-team">
      <div class="admin-panel-card">
        <div class="admin-panel-header">
          <div>
            <h2>Staff Technicians &amp; Roles</h2>
            <p class="admin-panel-sub">
              Add new team members, update bios and specialties, or remove technicians who have left the salon.
            </p>
          </div>
          <button type="button" class="btn btn-primary" id="btn-add-new-staff">
            + Add New Staff Member
          </button>
        </div>

        <div class="admin-team-list" id="admin-team-container">
          <!-- Populated dynamically -->
        </div>

        <!-- STAFF PORTAL LOGINS & PERMISSIONS (Admin Only) -->
        <div class="admin-accounts-section" style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border-delicate);">
          <div class="admin-panel-header" style="margin-bottom: 1.25rem;">
            <div>
              <h2>Staff Portal Logins &amp; Access Control</h2>
              <p class="admin-panel-sub">
                Create and manage login accounts for your technicians. Staff members can log in through the main website <strong>"Login"</strong> button using their username and password to access the staff portal.
              </p>
            </div>
            <button type="button" class="btn btn-primary" id="btn-create-staff-account">
              + Create Staff Login
            </button>
          </div>

          <div class="staff-accounts-table-wrap">
            <table class="staff-accounts-table">
              <thead>
                <tr>
                  <th>Staff Member</th>
                  <th>Username</th>
                  <th>Password</th>
                  <th>Portal Permissions</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="staff-accounts-tbody">
                <!-- Populated dynamically from window.SalonStore.getStaffAccounts() -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         TAB 7: ADMIN - GOOGLE REVIEWS MANAGER (Admin Only)
         ========================================== -->
    <section class="tab-pane" id="tab-admin-reviews">
      <div class="admin-panel-card">
        <div class="admin-panel-header">
          <div>
            <h2>⭐ Google Reviews &amp; Ratings Control</h2>
            <p class="admin-panel-sub">
              Manage verified Google Business reviews for Zarah Nails &amp; Beauty Massey. Per salon policy, only real customer reviews rated <strong>4★ and 5★</strong> are showcased on the public website.
            </p>
          </div>
          <div class="admin-header-actions" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="https://www.google.com/search?q=zara+nail+massey" target="_blank" rel="noopener noreferrer" class="btn btn-subtle" title="Open Google Business profile in Massey">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              View on Google Search
            </a>
            <button type="button" class="btn btn-secondary" id="btn-copy-review-invite">
              📋 Copy SMS Review Request
            </button>
            <button type="button" class="btn btn-primary" id="btn-add-google-review">
              + Add Google Review
            </button>
          </div>
        </div>

        <!-- Google Stats KPI Bar -->
        <div class="google-admin-kpi-bar" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
          <div class="kpi-mini-card" style="background: var(--bg-porcelain); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-delicate);">
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Average Rating</div>
            <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.35rem;">
              <span id="admin-google-avg-score" style="font-size: 2rem; font-weight: 700; color: var(--text-espresso);">4.9</span>
              <span style="color: #D4AF37; font-size: 1.2rem;">★★★★★</span>
            </div>
            <span style="font-size: 0.75rem; color: #3D6A52; font-weight: 600;">✓ Google Verified Listing</span>
          </div>

          <div class="kpi-mini-card" style="background: var(--bg-porcelain); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-delicate);">
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Displayed Reviews</div>
            <div style="margin-top: 0.35rem;">
              <span id="admin-google-count" style="font-size: 2rem; font-weight: 700; color: var(--text-espresso);">0</span>
              <span style="font-size: 0.85rem; color: var(--text-muted); margin-left: 0.35rem;">active on website</span>
            </div>
            <span style="font-size: 0.75rem; color: var(--accent-rose); font-weight: 600;">⭐ 4 &amp; 5 Stars Only</span>
          </div>

          <div class="kpi-mini-card" style="background: var(--bg-porcelain); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-delicate);">
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Listing Location</div>
            <div style="font-size: 0.9rem; font-weight: 600; color: var(--text-espresso); margin-top: 0.35rem;">Shop 12, 3 Red Hills Rd</div>
            <span style="font-size: 0.75rem; color: var(--text-muted);">Massey, Auckland • +64 210 839 8791</span>
          </div>
        </div>

        <!-- Google Reviews Table -->
        <div class="admin-reviews-table-wrap" style="overflow-x: auto;">
          <table class="portal-table" style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr>
                <th>Reviewer</th>
                <th>Rating</th>
                <th>Service Tag</th>
                <th>Date / Time</th>
                <th>Review Text</th>
                <th>Source</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="admin-reviews-tbody">
              <!-- Populated dynamically -->
            </tbody>
          </table>
        </div>

        <div style="margin-top: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <button type="button" class="btn btn-subtle btn-sm" id="btn-reset-google-reviews">
            🔄 Restore Real Google Defaults
          </button>
          <span style="font-size: 0.8rem; color: var(--text-muted);">
            Changes update instantly on the homepage without needing to rebuild the site.
          </span>
        </div>
      </div>
    </section>
  </div>

  <!-- ========================================================
       MODAL: 10-DOT CELEBRATION REWARD OVERLAY (Free Service)
       ======================================================== -->
  <div class="modal-backdrop reward-overlay-backdrop" id="loyalty-reward-overlay-modal" style="display: none;">
    <div class="reward-overlay-dialog">
      <div class="celebration-confetti-ribbon">
        <span class="confetti-icon">🎉</span>
        <span class="confetti-icon">✨</span>
        <span class="confetti-icon">👑</span>
      </div>

      <div class="reward-overlay-header">
        <span class="reward-eyebrow">MILESTONE ACHIEVED</span>
        <h2>Customer Entitled to Free Service!</h2>
        <p class="reward-sub">10 Green Loyalty Stamps have been completed at Zarah Nails &amp; Beauty Massey.</p>
      </div>

      <div class="reward-customer-spotlight">
        <div class="spotlight-avatar" id="reward-modal-avatar">S</div>
        <div class="spotlight-info">
          <h3 id="reward-modal-client-name">Sarah Jenkins</h3>
          <span id="reward-modal-client-phone">021 123 4567</span>
          <span id="reward-modal-client-email">sarah.jenkins@example.co.nz</span>
        </div>
        <div class="spotlight-free-tag">FREE SERVICE</div>
      </div>

      <!-- 10 Full Green Dots Preview -->
      <div class="reward-dots-stage">
        <div class="loyalty-dots-track large milestone-unlocked" id="reward-modal-dots-track">
          <!-- 10 glowing green dots -->
        </div>
        <span class="reward-completion-label">10 of 10 Completed Visits / Qualifying Services (🟢)</span>
      </div>

      <div class="reward-privilege-notice">
        <strong>Salon Privilege:</strong> This client has qualified for 1 complimentary salon service today (e.g. Signature Gel Manicure, Deluxe Pedicure treatment, or BIAB Infill) as a reward for their salon loyalty.
      </div>

      <div class="reward-modal-actions">
        <button type="button" class="btn btn-accent btn-lg" id="btn-redeem-free-service-now">
          🎁 Claim &amp; Redeem Free Service Now (Reset Stamp Card)
        </button>
        <button type="button" class="btn btn-subtle" id="btn-close-reward-overlay">
          Save for Next Visit (Keep 10 Stamps)
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================================
       MODAL: REGISTER CLIENT / LOG IN-STORE VISIT
       ======================================================== -->
  <div class="modal-backdrop" id="register-client-modal" style="display: none;">
    <div class="modal-dialog">
      <div class="modal-header">
        <h2 id="reg-client-modal-title">Register Client / Add Visit Point</h2>
        <button type="button" class="modal-close" id="btn-close-register-client">&times;</button>
      </div>
      <form id="register-client-form" class="modal-body">
        <input type="hidden" id="rc-customer-id" value="" />
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Client Full Name *</label>
            <input type="text" id="rc-name" class="form-input" placeholder="e.g. Kelly Roberts" required />
          </div>
          <div class="form-group">
            <label class="form-label">NZ Mobile Number *</label>
            <input type="tel" id="rc-phone" class="form-input" placeholder="021 555 7890" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Email Address (Optional)</label>
            <input type="email" id="rc-email" class="form-input" placeholder="kelly@example.co.nz" />
          </div>
          <div class="form-group">
            <label class="form-label">Favorite / Today's Service</label>
            <input type="text" id="rc-service" class="form-input" placeholder="BIAB Natural Overlay" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Service Price / Spend ($ NZD)</label>
            <input type="number" id="rc-spend" class="form-input" value="65" min="0" step="5" />
            <span class="auth-hint">Rule: Each service or $50 minimum spend earns 1 Green Dot (🟢)</span>
          </div>
          <div class="form-group">
            <label class="form-label">Action</label>
            <select id="rc-action" class="form-input">
              <option value="add-point">Mark Today's Visit (+1 Green Dot 🟢)</option>
              <option value="just-register">Just Register Contact Info</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Staff Notes (Nail shapes, cuticle sensitivity, etc.)</label>
          <textarea id="rc-notes" class="form-textarea" rows="2" placeholder="e.g. Likes short squoval, prefers Chloe"></textarea>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-subtle" id="btn-cancel-register-client">Cancel</button>
          <button type="submit" class="btn btn-primary" id="btn-save-register-client">Save Client &amp; Update Points</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: FAST WALK-IN / PHONE BOOKING -->
  <div class="modal-backdrop" id="walkin-modal" style="display: none;">
    <div class="modal-dialog">
      <div class="modal-header">
        <h2>Log Walk-In or Phone Booking</h2>
        <button type="button" class="modal-close" id="btn-close-walkin">&times;</button>
      </div>
      <form id="walkin-form" class="modal-body">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Client Name *</label>
            <input type="text" id="w-client-name" class="form-input" placeholder="e.g. Rachel Miller" required />
          </div>
          <div class="form-group">
            <label class="form-label">Phone Number *</label>
            <input type="tel" id="w-client-phone" class="form-input" placeholder="021 555 1234" required />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Service Treatment *</label>
          <select id="w-service" class="form-input" required>
            <!-- Populated from store -->
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Assign Technician *</label>
            <select id="w-staff" class="form-input" required>
              <!-- Populated from store -->
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Booking Type</label>
