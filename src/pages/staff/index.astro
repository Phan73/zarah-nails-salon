            </div>
            <div class="item-price-col">
              <span class="admin-price-display">${item.priceDisplay}</span>
            </div>
            <div class="item-actions-col">
              <button type="button" class="btn btn-subtle btn-sm btn-edit-service" data-cat-idx="${catIdx}" data-item-idx="${itemIdx}">
                Edit Price &amp; Info
              </button>
              <button type="button" class="btn-delete-item btn-delete-service" data-cat-idx="${catIdx}" data-item-idx="${itemIdx}" title="Delete service">
                &times;
              </button>
            </div>
          </div>
        `;
      }).join('');

      return `
        <div class="admin-category-box">
          <div class="admin-cat-header">
            <h3>${cat.category}</h3>
            <span>(${cat.items.length} items)</span>
          </div>
          <div class="admin-items-table">${itemsHtml}</div>
        </div>
      `;
    }).join('');

    const statServices = document.getElementById('stat-services-count');
    if (statServices) statServices.textContent = totalCount.toString();

    // Attach Edit and Delete buttons
    document.querySelectorAll('.btn-edit-service').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const catIdx = parseInt(e.currentTarget.getAttribute('data-cat-idx') || '0', 10);
        const itemIdx = parseInt(e.currentTarget.getAttribute('data-item-idx') || '0', 10);
        openServiceEditModal(catIdx, itemIdx);
      });
    });

    document.querySelectorAll('.btn-delete-service').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const catIdx = parseInt(e.currentTarget.getAttribute('data-cat-idx') || '0', 10);
        const itemIdx = parseInt(e.currentTarget.getAttribute('data-item-idx') || '0', 10);
        const item = activeServices[catIdx].items[itemIdx];
        if (confirm(`Are you sure you want to remove "${item.name}" from your salon menu?`)) {
          activeServices[catIdx].items.splice(itemIdx, 1);
          window.SalonStore.saveServices(activeServices);
          renderAdminServices();
          populateSelectDropdowns();
        }
      });
    });
  }

  // Open Service Edit Modal
  const serviceModal = document.getElementById('service-edit-modal');
  let editingCatIdx = -1;
  let editingItemIdx = -1;

  function openServiceEditModal(catIdx, itemIdx) {
    editingCatIdx = catIdx;
    editingItemIdx = itemIdx;

    if (catIdx >= 0 && itemIdx >= 0) {
      const item = activeServices[catIdx].items[itemIdx];
      document.getElementById('service-modal-title').textContent = 'Edit Service: ' + item.name;
      document.getElementById('se-id').value = item.id;
      document.getElementById('se-category').value = activeServices[catIdx].category;
      document.getElementById('se-name').value = item.name;
      document.getElementById('se-price').value = item.price.toString();
      document.getElementById('se-duration').value = item.duration;
      document.getElementById('se-description').value = item.description;
      document.getElementById('se-popular').checked = !!item.popular;
    } else {
      document.getElementById('service-modal-title').textContent = 'Add New Salon Treatment';
      document.getElementById('service-edit-form').reset();
      document.getElementById('se-id').value = 'service-' + Date.now();
    }

    if (serviceModal) serviceModal.style.display = 'flex';
  }

  document.getElementById('btn-add-new-service')?.addEventListener('click', () => {
    openServiceEditModal(-1, -1);
  });
  document.getElementById('btn-close-service-modal')?.addEventListener('click', () => {
    if (serviceModal) serviceModal.style.display = 'none';
  });
  document.getElementById('btn-cancel-service-edit')?.addEventListener('click', () => {
    if (serviceModal) serviceModal.style.display = 'none';
  });

  document.getElementById('service-edit-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const id = document.getElementById('se-id').value;
    const catName = document.getElementById('se-category').value;
    const name = document.getElementById('se-name').value;
    const price = parseFloat(document.getElementById('se-price').value);
    const duration = document.getElementById('se-duration').value;
    const desc = document.getElementById('se-description').value;
    const popular = document.getElementById('se-popular').checked;

    const newItem = {
      id,
      name,
      duration,
      price,
      priceDisplay: `$${price} NZD`,
      description: desc,
      popular
    };

    if (editingCatIdx >= 0 && editingItemIdx >= 0) {
      activeServices[editingCatIdx].items[editingItemIdx] = newItem;
    } else {
      // Find category or add to first
      let targetCat = activeServices.find(c => c.category === catName);
      if (!targetCat) {
        targetCat = { category: catName, description: 'Custom Treatments', items: [] };
        activeServices.push(targetCat);
      }
      targetCat.items.push(newItem);
    }

    window.SalonStore.saveServices(activeServices);
    alert(`Service "${name}" saved! Price is now $${price} NZD.`);
    if (serviceModal) serviceModal.style.display = 'none';
    renderAdminServices();
    populateSelectDropdowns();
  });

