<script is:inline define:vars={{ initialServices: servicesData, initialTeam: teamData, initialGallery: galleryData, initialInfo: salonInfo, initialCustomers: customersData, initialGoogleReviews: googleReviewsData }}>
  // Application State & Direct Session Setup
  const loggedUser = window.SalonStore ? window.SalonStore.getLoggedInUser() : null;
  let currentRole = (loggedUser && (loggedUser.role === 'admin' || loggedUser.role === 'staff'))
    ? loggedUser.role
    : (sessionStorage.getItem('zarah_role') || 'staff');

  sessionStorage.setItem('zarah_staff_auth', 'true');
  sessionStorage.setItem('zarah_role', currentRole);

  let pendingAdminTab = null;
  let activeServices = window.SalonStore ? window.SalonStore.getServices(initialServices) : initialServices;
  let activeTeam = window.SalonStore ? window.SalonStore.getTeam(initialTeam) : initialTeam;
  let activeGallery = window.SalonStore ? window.SalonStore.getGallery(initialGallery) : initialGallery;
  let activeCustomers = window.SalonStore ? window.SalonStore.getCustomers(initialCustomers) : initialCustomers;
  let selectedCustomerForReward = null;
  let currentCustomerFilter = 'all';
  let customerSearchQuery = '';
  let selectedAppointmentForReassign = null;
  let uploadedPhotoBase64 = null;

  // Sign out & Exit Button
  document.getElementById('btn-lock-portal')?.addEventListener('click', () => {
    if (confirm('Sign out of the salon workspace?')) {
      sessionStorage.removeItem('zarah_staff_auth');
      sessionStorage.removeItem('zarah_role');
      if (window.SalonStore) window.SalonStore.logoutAll();
      window.location.href = '/';
    }
  });

  // Admin Verification Challenge (When staff attempts admin-only actions)
  function openAdminChallenge(targetTab) {
    pendingAdminTab = targetTab;
    const challengeModal = document.getElementById('admin-challenge-modal');
    const cInput = document.getElementById('challenge-pin-input');
    if (challengeModal) challengeModal.style.display = 'flex';
    if (cInput) {
      cInput.value = '';
      cInput.focus();
    }
  }

  document.getElementById('btn-cancel-challenge')?.addEventListener('click', () => {
    const challengeModal = document.getElementById('admin-challenge-modal');
    if (challengeModal) challengeModal.style.display = 'none';
    pendingAdminTab = null;
  });

  document.getElementById('btn-submit-challenge')?.addEventListener('click', () => {
    const cInput = document.getElementById('challenge-pin-input');
    const val = cInput ? cInput.value.trim() : '';
    if (val === '258046' || val === '8888') {
      currentRole = 'admin';
      sessionStorage.setItem('zarah_role', 'admin');
      updateRoleUI();
      const challengeModal = document.getElementById('admin-challenge-modal');
      if (challengeModal) challengeModal.style.display = 'none';
      if (pendingAdminTab) {
        pendingAdminTab.click();
      }
      pendingAdminTab = null;
    } else {
      alert('Incorrect admin credentials. Please try again.');
    }
  });

  function updateRoleUI() {
    const roleTag = document.getElementById('active-role-tag');
    const headerBadge = document.getElementById('header-role-badge');
    const headerLabel = document.getElementById('header-user-label');

    const adminTabs = [
      document.getElementById('tab-btn-services'),
      document.getElementById('tab-btn-gallery'),
      document.getElementById('tab-btn-team'),
      document.getElementById('tab-btn-reviews')
    ];

    if (currentRole === 'admin') {
      if (roleTag) {
        roleTag.innerHTML = '<span class="role-icon">👑</span><span class="role-name">Owner / Admin Mode</span>';
        roleTag.className = 'active-role-indicator admin';
      }
      if (headerBadge) {
        headerBadge.textContent = '👑 Admin Workspace';
        headerBadge.classList.add('admin');
      }
      if (headerLabel) headerLabel.textContent = 'Salon Owner Active';

      adminTabs.forEach(t => {
        if (t) {
          t.classList.remove('admin-locked');
          t.textContent = t.textContent.replace('🔒 ', '⚙️ ');
        }
      });
    } else {
      if (roleTag) {
        roleTag.innerHTML = '<span class="role-icon">👤</span><span class="role-name">Normal Staff Mode</span>';
        roleTag.className = 'active-role-indicator';
      }
      if (headerBadge) {
        headerBadge.textContent = 'Staff Workspace';
        headerBadge.classList.remove('admin');
      }
      if (headerLabel) headerLabel.textContent = 'Staff Front Desk Active';

      adminTabs.forEach(t => {
        if (t) {
          t.classList.add('admin-locked');
          if (!t.textContent.includes('🔒')) {
            t.textContent = t.textContent.replace('⚙️ ', '🔒 ');
          }
