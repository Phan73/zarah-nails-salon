  document.getElementById('walkin-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('w-client-name').value;
    const phone = document.getElementById('w-client-phone').value;
    const serviceSelect = document.getElementById('w-service');
    const opt = serviceSelect.options[serviceSelect.selectedIndex];
    const sName = opt.getAttribute('data-name') || opt.text;
    const sPrice = opt.getAttribute('data-price') || '$50 NZD';
    const sDur = opt.getAttribute('data-duration') || '45 mins';

    const staffSelect = document.getElementById('w-staff');
    const stOpt = staffSelect.options[staffSelect.selectedIndex];
    const staffName = stOpt.getAttribute('data-name') || stOpt.text;
    const staffId = staffSelect.value;

    const dateVal = document.getElementById('w-date').value;
    const timeVal = document.getElementById('w-time').value;
    const sourceVal = document.getElementById('w-source').value;
    const notesVal = document.getElementById('w-notes').value;

    const newApp = {
      id: 'app-w-' + Date.now(),
      refCode: 'ZN-' + Math.floor(1000 + Math.random() * 9000),
      clientName: name,
      clientPhone: phone,
      serviceName: sName,
      price: sPrice,
      duration: sDur,
      staffName,
      staffId,
      date: dateVal,
      time: timeVal,
      status: 'confirmed',
      source: sourceVal,
      clientNotes: notesVal
    };

    const appointments = JSON.parse(localStorage.getItem('zarah_appointments') || '[]');
    appointments.unshift(newApp);
    localStorage.setItem('zarah_appointments', JSON.stringify(appointments));

    // Automatically add the customer to the 10-Dot Loyalty Point System!
    if (window.SalonStore) {
      window.SalonStore.registerCustomerBooking({
        name: name,
        phone: phone,
        email: '',
        serviceName: sName,
        notes: notesVal,
        source: sourceVal
      });
      renderCustomerDirectory();
    }

    // If this booking converted an inbox message, remove it from the inbox
    if (activeConvertingMessageId) {
      try {
        const msgs = JSON.parse(localStorage.getItem('zarah_messages') || '[]');
        const filtered = msgs.filter(m => m.id !== activeConvertingMessageId);
        localStorage.setItem('zarah_messages', JSON.stringify(filtered));
        activeConvertingMessageId = null;
        renderMessages();
      } catch (err) {}
    }

    alert(`Appointment for ${name} has been added to ${staffName}'s calendar! 1 Orange loyalty stamp (🟠) has been reserved on their account.`);
    document.getElementById('walkin-form').reset();
