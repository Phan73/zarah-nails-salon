    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .admin-cat-header {
    background-color: var(--bg-stone);
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .admin-cat-header h3 {
    font-size: 1.1rem;
  }

  .admin-cat-header span {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .admin-items-table {
    display: flex;
    flex-direction: column;
  }

  .admin-item-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-delicate);
    gap: 1rem;
  }

  .admin-item-row:last-child {
    border-bottom: none;
  }

  .item-main-col {
    flex: 1;
  }

  .item-name-line {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .item-sub-info {
    font-size: 0.8rem;
    color: var(--text-muted);
    display: block;
    margin-top: 0.2rem;
  }

  .item-price-col {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-rose);
  }

  .item-actions-col {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .btn-delete-item {
    background: transparent;
    border: none;
    font-size: 1.35rem;
    color: var(--state-danger);
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
  }

  /* Admin Gallery Grid */
  .admin-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .admin-gallery-card {
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .admin-gallery-thumb {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--bg-stone);
  }

  .admin-gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .admin-gallery-info {
    padding: 1rem;
    flex: 1;
  }

  .gallery-card-price {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--accent-rose);
    display: block;
    margin: 0.25rem 0;
  }

  .gallery-card-tags {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .admin-gallery-actions {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--border-delicate);
    background-color: var(--bg-porcelain);
  }

  .btn-delete-gallery {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--state-danger);
  }

  .photo-preview-wrap {
    margin-top: 0.75rem;
    max-width: 200px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border-delicate);
  }

  .photo-preview-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* Admin Staff Rows */
  .admin-team-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .admin-staff-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
  }

  .staff-avatar-chip {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-rose) 0%, var(--gold-champagne) 100%);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .staff-info-col {
    flex: 1;
  }

  .staff-role-sub {
    font-size: 0.82rem;
    color: var(--text-muted);
    display: block;
  }

  .staff-spec-sub {
    font-size: 0.8rem;
    color: var(--text-cocoa);
    margin-top: 0.2rem;
  }

  /* Modals */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(36, 30, 28, 0.6);
    backdrop-filter: blur(4px);
    z-index: 250;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .modal-dialog {
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    max-width: 580px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: var(--shadow-modal);
  }

  .modal-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-delicate);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-close {
    background: transparent;
    border: none;
    font-size: 1.75rem;
    cursor: pointer;
    line-height: 1;
  }

  .modal-body {
    padding: 1.5rem;
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-delicate);
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .form-input, .form-textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
  }

  .form-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    cursor: pointer;
  }

  /* Shifts Grid */
  .shifts-panel {
    background-color: #FFFFFF;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
    padding: 2rem;
  }

  .staff-roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .roster-card {
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .roster-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .roster-role {
    font-size: 0.8rem;
    color: var(--accent-rose);
    font-weight: 600;
  }

  .status-chip {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }

  .status-chip.active {
    background-color: var(--state-success-bg);
    color: var(--state-success);
  }

  /* SMS Box */
  .reassign-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .reassign-summary-box {
    background-color: var(--bg-stone);
    border-radius: var(--radius-sm);
    padding: 1rem;
    margin-bottom: 1.25rem;
    font-size: 0.88rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .sms-preview-card {
    background-color: #FAF8F5;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
    padding: 1rem;
    margin-top: 1.25rem;
  }

  .sms-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .sms-tag {
    color: var(--state-success);
  }

  .sms-bubble {
    background-color: #EBF8FF;
    border: 1px solid #BEE3F8;
    color: #2C5282;
    padding: 0.85rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .empty-state-card {
    background-color: #FFFFFF;
    border: 1px dashed var(--border-delicate);
    border-radius: var(--radius-md);
    padding: 3rem 1.5rem;
    text-align: center;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 820px) {
    .appointment-card {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .app-staff-col {
      align-items: flex-start;
    }
    .admin-item-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
  /* Gallery Mode Tabs */
  .gallery-creator-mode-tabs {
    display: flex;
    background-color: var(--bg-stone);
    border-bottom: 1px solid var(--border-delicate);
    padding: 0.35rem 1.5rem 0 1.5rem;
    gap: 0.5rem;
  }

  .creator-mode-btn {
    padding: 0.65rem 1.25rem;
    background: transparent;
    border: none;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }

  .creator-mode-btn.active {
    color: var(--text-espresso);
    border-bottom-color: var(--accent-rose);
    background-color: #FFFFFF;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  /* Prompt Generator Box */
  .ai-generator-inner-box {
    background-color: var(--bg-porcelain);
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .prompt-bar-row {
    display: flex;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
  }

  .prompt-bar-row input {
    flex: 1;
  }

  .prompt-presets-container {
    margin-bottom: 1rem;
  }

  .presets-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .presets-chips-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .prompt-chip {
    padding: 0.3rem 0.65rem;
    background-color: #FFFFFF;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-espresso);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .prompt-chip:hover {
    border-color: var(--accent-rose);
    background-color: var(--accent-rose-soft);
  }

  /* Tuning Accordion */
  .tuning-accordion {
    border-top: 1px dashed var(--border-delicate);
    padding-top: 0.75rem;
  }

  .tuning-accordion summary {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    margin-bottom: 0.75rem;
  }

  .tuning-controls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
  }

  .tuning-controls-grid .form-label {
    font-size: 0.75rem;
  }

  .tuning-controls-grid .form-input {
    font-size: 0.82rem;
    padding: 0.45rem;
  }

  /* Look Editor Preview Card */
  .look-editor-preview-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    background-color: #FFFFFF;
  }

  .preview-media-frame {
    aspect-ratio: 1 / 1.15;
    background-color: var(--bg-stone);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-delicate);
  }

  .preview-empty-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.8rem;
    gap: 0.5rem;
  }

  .preview-details-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .look-editor-preview-card {
      grid-template-columns: 1fr;
    }
    .prompt-bar-row {
      flex-direction: column;
    }
  }

  /* ========================================================
     STAFF PORTAL — 10-DOT CUSTOMER LOYALTY & REWARDS STYLES
     ======================================================== */
  .loyalty-mgmt-panel {
    background-color: #FFFFFF;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-subtle);
  }

  .loyalty-mgmt-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .loyalty-mgmt-sub {
    font-size: 0.9rem;
    color: var(--text-cocoa);
    margin-top: 0.25rem;
    line-height: 1.5;
  }

  .legend-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background-color: var(--bg-stone);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    margin: 0 0.2rem;
  }

  /* Search & Filter Bar */
  .customer-search-filter-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.75rem;
    background-color: var(--bg-stone);
    padding: 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-delicate);
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #FFFFFF;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-sm);
    padding: 0.65rem 1rem;
    color: var(--text-muted);
  }

  .search-field {
    border: none;
    outline: none;
    width: 100%;
    font-size: 0.92rem;
    color: var(--text-espresso);
    background: transparent;
  }

  .customer-filter-chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cust-filter-chip {
    padding: 0.4rem 0.85rem;
    background-color: #FFFFFF;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-espresso);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .cust-filter-chip:hover {
    border-color: var(--accent-rose);
  }

  .cust-filter-chip.active {
    background-color: var(--text-espresso);
    color: #FAF8F5;
    border-color: var(--text-espresso);
  }

  .cust-filter-chip.highlight-gold {
    border-color: #F59E0B;
    color: #B45309;
  }

  .cust-filter-chip.highlight-gold.active {
    background: linear-gradient(135deg, #F59E0B, #D97706);
    color: #FFFFFF;
  }

  /* Customer Directory Grid */
  .customers-directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.25rem;
  }

  .customer-mgmt-card {
    background-color: #FFFFFF;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all var(--transition-smooth);
    box-shadow: var(--shadow-subtle);
  }

  .customer-mgmt-card:hover {
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  .customer-mgmt-card.reward-unlocked-card {
    border: 2px solid #F59E0B;
    background: linear-gradient(to bottom, #FFFDF8, #FFFFFF);
    box-shadow: 0 4px 16px rgba(245, 158, 11, 0.2);
  }

  .cust-card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .cust-card-profile {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cust-avatar-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--bg-stone-dark);
    color: var(--text-espresso);
    font-weight: 700;
    font-size: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cust-avatar-circle.gold {
    background: linear-gradient(135deg, #F59E0B, #D97706);
    color: #FFFFFF;
  }

  .cust-name-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cust-name-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--text-espresso);
  }

  .cust-contact-chips {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .cust-chip {
    font-size: 0.75rem;
    color: var(--text-muted);
    background-color: var(--bg-stone);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .cust-chip.provider-chip {
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--text-cocoa);
  }

  .points-pill-label {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background-color: var(--bg-stone);
    color: var(--text-cocoa);
    display: inline-block;
  }

  .points-pill-label.gold {
    background-color: #FEF3C7;
    color: #B45309;
    border: 1px solid #F59E0B;
  }

  .cust-dots-track-wrap {
    background-color: var(--bg-stone);
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .cust-dots-caption {
    display: flex;
    gap: 0.85rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    justify-content: center;
  }

  .cust-stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    background-color: #FAFAFA;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.65rem;
    text-align: center;
  }

  .c-stat-label {
    display: block;
    font-size: 0.68rem;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .c-stat-val {
    font-size: 0.95rem;
    color: var(--text-espresso);
  }

  .c-stat-val-sm {
    font-size: 0.78rem;
    color: var(--text-espresso);
    font-weight: 600;
  }

  .cust-notes-bar {
    font-size: 0.8rem;
    background-color: #FFFDF8;
    border-left: 3px solid var(--gold-champagne);
    padding: 0.35rem 0.65rem;
    color: var(--text-cocoa);
  }

  .cust-card-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
  }

  .empty-customers-box {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem 1rem;
    background-color: var(--bg-stone);
    border-radius: var(--radius-md);
    border: 1px dashed var(--border-delicate);
    color: var(--text-muted);
  }

  /* ========================================================
     OVERLAY NOTIFICATION WINDOW: 10-DOT REWARD EARNED
     ======================================================== */
  .reward-overlay-backdrop {
    background-color: rgba(36, 30, 28, 0.78);
    backdrop-filter: blur(8px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: fadeIn 0.25s ease-out;
  }

  .reward-overlay-dialog {
    background: linear-gradient(to bottom, #FFFFFF, #FAF8F5);
    border: 2px solid #F59E0B;
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 64px rgba(245, 158, 11, 0.35), 0 10px 30px rgba(0, 0, 0, 0.3);
    max-width: 540px;
    width: 100%;
    padding: 2.25rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    animation: popUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .celebration-confetti-ribbon {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    font-size: 2.25rem;
    margin-bottom: 0.5rem;
    animation: bounceSparkle 1.8s ease-in-out infinite alternate;
  }

  @keyframes bounceSparkle {
    0% { transform: translateY(0); }
    100% { transform: translateY(-6px); }
  }

  .reward-eyebrow {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: #D97706;
    text-transform: uppercase;
  }

  .reward-overlay-header h2 {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    color: var(--text-espresso);
    margin: 0.35rem 0 0.5rem 0;
  }

  .reward-sub {
    font-size: 0.92rem;
    color: var(--text-cocoa);
    margin-bottom: 1.5rem;
  }

  .reward-customer-spotlight {
    display: flex;
