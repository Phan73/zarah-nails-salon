    },
    lavender: {
      name: 'Lavender Lilac',
      bg1: '#FAF8F7', bg2: '#EBE5F2',
      base: '#D6C7EC', dark: '#9F88C5', accent: '#ECE2F9',
      highlight: '#FFFFFF'
    },
    blue: {
      name: 'Baby Blue',
      bg1: '#FAF8F5', bg2: '#E3ECF5',
      base: '#B8D5E5', dark: '#7FA8C5', accent: '#DDF0FA',
      highlight: '#FFFFFF'
    }
  };

  const SHAPE_PATHS = {
    almond: 'M70,30 C120,30 160,80 160,200 L160,390 C160,410 80,410 80,390 L80,200 C80,80 70,30 70,30 Z',
    coffin: 'M60,40 L150,40 L165,130 L165,390 C165,410 75,410 75,390 L75,130 Z',
    squoval: 'M65,40 C105,40 145,40 145,100 L145,390 C145,410 65,410 65,390 L65,100 C65,40 65,40 65,40 Z',
    square: 'M60,40 L150,40 L150,390 C150,410 60,410 60,390 Z'
  };

  function parseNailPrompt(promptText) {
    const text = (promptText || '').toLowerCase();
    
    let shape = 'almond';
    if (text.includes('coffin') || text.includes('ballerina')) shape = 'coffin';
    else if (text.includes('squoval')) shape = 'squoval';
    else if (text.includes('square')) shape = 'square';

    let technique = 'chrome';
    if (text.includes('cat eye') || text.includes('cat-eye') || text.includes('magnetic') || text.includes('velvet')) technique = 'cateye';
    else if (text.includes('aura') || text.includes('airbrush') || text.includes('halo')) technique = 'aura';
    else if (text.includes('ombre') || text.includes('baby boomer') || text.includes('fade')) technique = 'ombre';
    else if (text.includes('french') || text.includes('micro') || text.includes('tip')) technique = 'french';
    else if (text.includes('chrome') || text.includes('glazed') || text.includes('pearl') || text.includes('hailey')) technique = 'chrome';
    else if (text.includes('solid') || text.includes('gloss')) technique = 'solid';

    let colorTheme = 'rose';
    if (text.includes('emerald') || text.includes('green') || text.includes('sage') || text.includes('forest')) colorTheme = 'emerald';
    else if (text.includes('lavender') || text.includes('lilac') || text.includes('purple')) colorTheme = 'lavender';
    else if (text.includes('peach') || text.includes('sunset') || text.includes('coral') || text.includes('apricot')) colorTheme = 'peach';
    else if (text.includes('espresso') || text.includes('chocolate') || text.includes('brown') || text.includes('tortoiseshell')) colorTheme = 'espresso';
    else if (text.includes('burgundy') || text.includes('wine') || text.includes('cherry') || text.includes('red')) colorTheme = 'burgundy';
    else if (text.includes('pearl') || text.includes('white') || text.includes('chalk') || text.includes('milky')) colorTheme = 'pearl';
    else if (text.includes('blue') || text.includes('sky') || text.includes('ocean')) colorTheme = 'blue';

    let embellish = 'none';
    if (text.includes('star') || text.includes('sparkle') || text.includes('twinkle')) embellish = 'star';
    else if (text.includes('pearl') || text.includes('gem') || text.includes('crystal')) embellish = 'pearl';
    else if (text.includes('gold') || text.includes('flake') || text.includes('foil')) embellish = 'gold-flakes';

    return { shape, technique, colorTheme, embellish };
  }

  function generateNailArtSVG(opts) {
    const pal = COLOR_PALETTES[opts.colorTheme] || COLOR_PALETTES.rose;
    const nailPath = SHAPE_PATHS[opts.shape] || SHAPE_PATHS.almond;

    let techniqueMarkup = '';
    if (opts.technique === 'chrome') {
      techniqueMarkup = `
        <defs>
          <linearGradient id="chromeShine" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="${pal.highlight}" stop-opacity="0.9"/>
            <stop offset="40%" stop-color="${pal.accent}" stop-opacity="0.5"/>
            <stop offset="70%" stop-color="#D4AF37" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="${pal.base}" stop-opacity="0.8"/>
          </linearGradient>
        </defs>
        <path d="${nailPath}" fill="url(#chromeShine)"/>
        <path d="M95,70 Q125,140 130,320" fill="none" stroke="#FFFFFF" stroke-width="7" stroke-linecap="round" opacity="0.85"/>
        <path d="M88,90 Q105,130 110,240" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
      `;
    } else if (opts.technique === 'cateye') {
      techniqueMarkup = `
        <defs>
          <linearGradient id="catEyeBand" x1="20%" y1="80%" x2="80%" y2="20%">
            <stop offset="0%" stop-color="rgba(255,255,255,0)"/>
            <stop offset="42%" stop-color="${pal.accent}" stop-opacity="0.8"/>
            <stop offset="50%" stop-color="#FFFFFF" stop-opacity="0.95"/>
            <stop offset="58%" stop-color="${pal.accent}" stop-opacity="0.8"/>
            <stop offset="100%" stop-color="rgba(255,255,255,0)"/>
          </linearGradient>
        </defs>
        <path d="${nailPath}" fill="url(#catEyeBand)"/>
        <path d="M95,70 Q125,140 130,320" fill="none" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" opacity="0.6"/>
      `;
    } else if (opts.technique === 'aura') {
      techniqueMarkup = `
        <defs>
          <radialGradient id="auraGlow" cx="50%" cy="45%" r="48%">
            <stop offset="0%" stop-color="${pal.dark}" stop-opacity="0.95"/>
            <stop offset="35%" stop-color="${pal.accent}" stop-opacity="0.75"/>
            <stop offset="70%" stop-color="${pal.base}" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="${pal.base}" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <circle cx="108" cy="210" r="95" fill="url(#auraGlow)"/>
        <path d="M95,70 Q125,140 130,320" fill="none" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" opacity="0.7"/>
      `;
    } else if (opts.technique === 'ombre') {
      techniqueMarkup = `
        <defs>
          <linearGradient id="ombreGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#FFFFFF"/>
            <stop offset="30%" stop-color="#FCF8F5"/>
            <stop offset="60%" stop-color="${pal.base}"/>
            <stop offset="100%" stop-color="${pal.dark}"/>
          </linearGradient>
        </defs>
        <path d="${nailPath}" fill="url(#ombreGrad)"/>
        <path d="M95,70 Q125,140 130,320" fill="none" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round" opacity="0.75"/>
      `;
    } else if (opts.technique === 'french') {
      techniqueMarkup = `
        <path d="M60,30 C110,30 150,75 150,90 C125,70 85,70 60,90 Z" fill="${pal.dark}"/>
        <path d="M62,88 C85,68 125,68 148,88" fill="none" stroke="#D4AF37" stroke-width="1.8"/>
        <path d="M95,70 Q125,140 130,320" fill="none" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" opacity="0.6"/>
      `;
    } else {
      techniqueMarkup = `
        <path d="M95,70 Q125,140 130,320" fill="none" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round" opacity="0.65"/>
      `;
    }

    let embellishMarkup = '';
    if (opts.embellish === 'star') {
      embellishMarkup = `
        <path d="M145,90 Q145,102 157,102 Q145,102 145,114 Q145,102 133,102 Q145,102 145,90 Z" fill="#D4AF37"/>
        <path d="M80,180 Q80,190 90,190 Q80,190 80,200 Q80,190 70,190 Q80,190 80,180 Z" fill="#D4AF37" opacity="0.85"/>
        <circle cx="145" cy="102" r="2" fill="#FFFFFF"/>
      `;
    } else if (opts.embellish === 'pearl') {
      embellishMarkup = `
        <g transform="translate(105, 195)">
          <circle cx="0" cy="2" r="8" fill="rgba(0,0,0,0.15)"/>
          <circle cx="0" cy="0" r="7.5" fill="#FFFFFF"/>
          <circle cx="-2" cy="-2" r="2.5" fill="#FFF" opacity="0.9"/>
        </g>
      `;
    } else if (opts.embellish === 'gold-flakes') {
      embellishMarkup = `
        <polygon points="120,80 126,82 124,88 118,85" fill="#D4AF37" opacity="0.9"/>
        <polygon points="140,110 148,114 144,120 138,116" fill="#D4AF37" opacity="0.85"/>
        <polygon points="90,140 96,142 93,148 88,145" fill="#D4AF37" opacity="0.8"/>
        <polygon points="135,160 142,163 139,170 133,166" fill="#D4AF37" opacity="0.75"/>
      `;
    }

    const svg = `
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700" width="600" height="700">
        <defs>
          <linearGradient id="canvasBg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="${pal.bg1}"/>
            <stop offset="100%" stop-color="${pal.bg2}"/>
          </linearGradient>
          <filter id="nailShadow" x="-10%" y="-10%" width="130%" height="130%">
            <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#241E1C" flood-opacity="0.14"/>
          </filter>
        </defs>
        <rect width="600" height="700" fill="url(#canvasBg)"/>
        <path d="M-50,200 Q200,100 450,350 T800,600" fill="none" stroke="${pal.dark}" stroke-width="1.5" opacity="0.25"/>
        <circle cx="500" cy="180" r="140" fill="${pal.dark}" opacity="0.08"/>

        <g filter="url(#nailShadow)" transform="translate(185, 110)">
          <path d="${nailPath}" fill="${pal.base}"/>
          ${techniqueMarkup}
          <path d="M85,385 C105,405 135,405 155,385" fill="none" stroke="${pal.dark}" stroke-width="2.5" opacity="0.5"/>
          ${embellishMarkup}
        </g>

        <rect x="50" y="580" width="500" height="75" rx="12" fill="#FFFFFF" opacity="0.94"/>
        <text x="80" y="614" font-family="'Playfair Display', serif" font-size="20" font-weight="600" fill="#241E1C">${opts.title || pal.name}</text>
        <text x="80" y="636" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="600" letter-spacing="1.5" fill="#8C7A70">ZARAH NAILS &amp; BEAUTY MASSEY</text>
        <text x="470" y="625" font-family="'Playfair Display', serif" font-size="20" font-weight="700" fill="#B58A7E" text-anchor="end">${opts.price || '$60 NZD'}</text>
      </svg>
    `;

    return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg.trim());
  }

  function runPromptGeneration(customPrompt) {
    const promptText = customPrompt || document.getElementById('ai-prompt-input')?.value || 'Glazed pearlescent chrome over bare rose almond nails';
    const parsed = parseNailPrompt(promptText);

    const shapeSelect = document.getElementById('tune-shape');
    const techSelect = document.getElementById('tune-technique');
    const colorSelect = document.getElementById('tune-color');
    const embSelect = document.getElementById('tune-embellish');

    if (shapeSelect) shapeSelect.value = parsed.shape;
    if (techSelect) techSelect.value = parsed.technique;
    if (colorSelect) colorSelect.value = parsed.colorTheme;
    if (embSelect) embSelect.value = parsed.embellish;

    const palName = COLOR_PALETTES[parsed.colorTheme]?.name || 'Nail Art';
    const techNames = {
      chrome: 'Glazed Chrome',
      cateye: 'Velvet Cat-Eye',
      aura: 'Aura Airbrush',
      ombre: 'French Ombre Fade',
      french: 'Micro French Tip',
      solid: 'High-Gloss Gel'
    };
    const shapeNames = {
      almond: 'Almond',
      coffin: 'Coffin',
      squoval: 'Squoval',
      square: 'Square'
    };

    const generatedTitle = `${palName} ${techNames[parsed.technique]} (${shapeNames[parsed.shape]})`;
    const generatedPrice = parsed.technique === 'cateye' || parsed.technique === 'aura' ? '$65 NZD' : '$60 NZD';
    const generatedTags = [techNames[parsed.technique], shapeNames[parsed.shape], 'BIAB', 'Trend'];
    const generatedDesc = `Bespoke ${techNames[parsed.technique].toLowerCase()} design crafted on ${shapeNames[parsed.shape].toLowerCase()} extensions with high-shine protective topcoat.`;

    const svgDataUri = generateNailArtSVG({
      shape: parsed.shape,
      technique: parsed.technique,
      colorTheme: parsed.colorTheme,
      embellish: parsed.embellish,
      title: generatedTitle,
      price: generatedPrice
    });

    uploadedPhotoBase64 = svgDataUri;

    if (geImagePreview) {
      geImagePreview.src = svgDataUri;
      geImagePreview.style.display = 'block';
    }
    if (gePlaceholder) gePlaceholder.style.display = 'none';

    document.getElementById('ge-title').value = generatedTitle;
    document.getElementById('ge-price').value = generatedPrice;
    document.getElementById('ge-tags').value = generatedTags.join(', ');
    document.getElementById('ge-desc').value = generatedDesc;
  }

  document.getElementById('btn-run-ai-generate')?.addEventListener('click', () => {
    runPromptGeneration(null);
  });

  document.querySelectorAll('.prompt-chip').forEach(chip => {
    chip.addEventListener('click', (e) => {
      const p = e.currentTarget.getAttribute('data-prompt');
      const input = document.getElementById('ai-prompt-input');
      if (input) input.value = p;
      runPromptGeneration(p);
    });
  });

  ['tune-shape', 'tune-technique', 'tune-color', 'tune-embellish'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', () => {
      const shape = document.getElementById('tune-shape').value;
      const tech = document.getElementById('tune-technique').value;
      const color = document.getElementById('tune-color').value;
      const emb = document.getElementById('tune-embellish').value;

      const palName = COLOR_PALETTES[color]?.name || 'Nail Art';
      const techNames = {
        chrome: 'Glazed Chrome',
        cateye: 'Velvet Cat-Eye',
        aura: 'Aura Airbrush',
        ombre: 'French Ombre Fade',
        french: 'Micro French Tip',
        solid: 'High-Gloss Gel'
      };
      const shapeNames = {
        almond: 'Almond',
        coffin: 'Coffin',
        squoval: 'Squoval',
        square: 'Square'
      };

      const generatedTitle = `${palName} ${techNames[tech]} (${shapeNames[shape]})`;
      const generatedPrice = tech === 'cateye' || tech === 'aura' ? '$65 NZD' : '$60 NZD';

      const svgDataUri = generateNailArtSVG({
        shape,
        technique: tech,
        colorTheme: color,
        embellish: emb,
        title: generatedTitle,
        price: generatedPrice
      });

      uploadedPhotoBase64 = svgDataUri;
      if (geImagePreview) {
        geImagePreview.src = svgDataUri;
        geImagePreview.style.display = 'block';
      }
      if (gePlaceholder) gePlaceholder.style.display = 'none';
      document.getElementById('ge-title').value = generatedTitle;
      document.getElementById('ge-price').value = generatedPrice;
    });
  });

  document.getElementById('btn-close-gallery-modal')?.addEventListener('click', () => {
    if (galleryModal) galleryModal.style.display = 'none';
  });
  document.getElementById('btn-cancel-gallery-edit')?.addEventListener('click', () => {
    if (galleryModal) galleryModal.style.display = 'none';
  });

  document.getElementById('gallery-edit-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!uploadedPhotoBase64) {
      alert('Please generate a design or select a photo from your device first.');
      return;
    }

    const title = document.getElementById('ge-title').value;
    const price = document.getElementById('ge-price').value;
    const tagsRaw = document.getElementById('ge-tags').value;
    const desc = document.getElementById('ge-desc').value;
    const tags = tagsRaw.split(',').map(t => t.trim()).filter(Boolean);

    const newLook = {
      id: 'look-' + Date.now(),
      title,
      category: 'Nail Art',
      serviceId: 'biab-full-overlay',
      serviceName: 'Custom Nail Art Set',
      price: price.startsWith('$') ? price : `$${price} NZD`,
      duration: '60 mins',
      description: desc,
      tags: tags.length ? tags : ['Nail Art', 'Trending'],
      image: uploadedPhotoBase64
    };

    activeGallery.unshift(newLook);
    window.SalonStore.saveGallery(activeGallery);
    alert(`Look "${title}" published live to the public gallery!`);
    if (galleryModal) galleryModal.style.display = 'none';
    renderAdminGallery();
  });

  // ==========================================
  // ADMIN 3: STAFF ROSTER MANAGER
  // ==========================================
  function renderAdminTeam() {
    const container = document.getElementById('admin-team-container');
    if (!container) return;

    const activeTechs = activeTeam.filter(t => t.id !== 'any-available');
    container.innerHTML = activeTechs.map((staff, idx) => `
      <div class="admin-staff-row" data-idx="${idx}">
        <div class="staff-avatar-chip">
          <span>${staff.name.charAt(0)}</span>
        </div>
        <div class="staff-info-col">
          <strong>${staff.name}</strong>
          <span class="staff-role-sub">${staff.role} • 📞 ${staff.phone}</span>
          <p class="staff-spec-sub">Specialties: ${staff.specialties.join(', ')}</p>
        </div>
        <div class="staff-actions-col">
          <button type="button" class="btn btn-subtle btn-sm btn-edit-staff" data-idx="${idx}">
            Edit Profile
          </button>
          <button type="button" class="btn-delete-item btn-delete-staff" data-idx="${idx}" title="Remove staff member">
            &times;
          </button>
        </div>
      </div>
    `).join('');

    const statCount = document.getElementById('stat-active-staff-count');
    const statNames = document.getElementById('stat-staff-names');
    if (statCount) statCount.textContent = activeTechs.length.toString();
    if (statNames) statNames.textContent = activeTechs.map(t => t.name).join(' • ');

    document.querySelectorAll('.btn-edit-staff').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-idx') || '0', 10);
        openStaffEditModal(idx);
      });
    });

    document.querySelectorAll('.btn-delete-staff').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-idx') || '0', 10);
        if (confirm(`Remove "${activeTechs[idx].name}" from your active salon roster?`)) {
          const removedId = activeTechs[idx].id;
          activeTeam = activeTeam.filter(t => t.id !== removedId);
          window.SalonStore.saveTeam(activeTeam);
          renderAdminTeam();
          renderStaffRosters();
          populateSelectDropdowns();
        }
      });
    });
  }

  const staffModal = document.getElementById('staff-edit-modal');
  let editingStaffIdx = -1;

  function openStaffEditModal(idx) {
    editingStaffIdx = idx;
    const activeTechs = activeTeam.filter(t => t.id !== 'any-available');

    if (idx >= 0 && activeTechs[idx]) {
      const staff = activeTechs[idx];
      document.getElementById('staff-modal-title').textContent = 'Edit Technician: ' + staff.name;
      document.getElementById('ste-id').value = staff.id;
      document.getElementById('ste-name').value = staff.name;
      document.getElementById('ste-phone').value = staff.phone || '0210 839 8791';
      document.getElementById('ste-role').value = staff.role;
      document.getElementById('ste-specialties').value = staff.specialties.join(', ');
      document.getElementById('ste-bio').value = staff.bio;
    } else {
      document.getElementById('staff-modal-title').textContent = 'Add New Technician';
      document.getElementById('staff-edit-form').reset();
      document.getElementById('ste-id').value = 'staff-' + Date.now();
    }

    if (staffModal) staffModal.style.display = 'flex';
  }

  document.getElementById('btn-add-new-staff')?.addEventListener('click', () => {
    openStaffEditModal(-1);
  });
  document.getElementById('btn-close-staff-modal')?.addEventListener('click', () => {
    if (staffModal) staffModal.style.display = 'none';
  });
  document.getElementById('btn-cancel-staff-edit')?.addEventListener('click', () => {
    if (staffModal) staffModal.style.display = 'none';
  });

  document.getElementById('staff-edit-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const id = document.getElementById('ste-id').value;
    const name = document.getElementById('ste-name').value;
    const phone = document.getElementById('ste-phone').value;
    const role = document.getElementById('ste-role').value;
    const specRaw = document.getElementById('ste-specialties').value;
    const bio = document.getElementById('ste-bio').value;
    const specialties = specRaw.split(',').map(s => s.trim()).filter(Boolean);

    const newStaff = {
      id,
      name,
      role,
      bio,
      specialties,
      phone,
      active: true
    };

    const activeTechs = activeTeam.filter(t => t.id !== 'any-available');
    if (editingStaffIdx >= 0) {
      const oldId = activeTechs[editingStaffIdx].id;
      const teamIdx = activeTeam.findIndex(t => t.id === oldId);
      if (teamIdx >= 0) activeTeam[teamIdx] = newStaff;
    } else {
      activeTeam.unshift(newStaff);
    }

    window.SalonStore.saveTeam(activeTeam);
    alert(`Technician profile for "${name}" saved!`);
    if (staffModal) staffModal.style.display = 'none';
    renderAdminTeam();
    renderStaffRosters();
    populateSelectDropdowns();
  });

  // ==========================================
  // STAFF PORTAL LOGINS & PERMISSIONS CONTROLLER
  // ==========================================
  function renderStaffAccounts() {
    const tbody = document.getElementById('staff-accounts-tbody');
    if (!tbody || !window.SalonStore) return;

    const accounts = window.SalonStore.getStaffAccounts();
    if (accounts.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">No staff logins created yet. Click "+ Create Staff Login" above to register technician credentials.</td></tr>`;
      return;
    }

    tbody.innerHTML = accounts.map(a => `
      <tr>
        <td><strong>${a.name}</strong></td>
        <td><code>${a.username}</code></td>
        <td><code>${a.password}</code></td>
        <td>
          <span class="badge ${a.role === 'admin' ? 'badge-gold' : 'badge-rose'}">
            ${a.role === 'admin' ? '👑 Owner / Admin' : '👥 Normal Staff'}
          </span>
        </td>
        <td><span class="badge badge-success">Active</span></td>
        <td>
          <div style="display: flex; gap: 0.4rem;">
            <button type="button" class="btn btn-subtle btn-sm btn-edit-staff-acc" data-id="${a.id}">Edit</button>
            <button type="button" class="btn btn-subtle btn-sm btn-del-staff-acc" data-id="${a.id}" style="color: var(--state-danger);">&times;</button>
          </div>
        </td>
      </tr>
    `).join('');

    // Attach actions
    document.querySelectorAll('.btn-edit-staff-acc').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = e.currentTarget.getAttribute('data-id');
        const acc = accounts.find(a => a.id === id);
        if (acc) openStaffAccountModal(acc);
      });
    });

    document.querySelectorAll('.btn-del-staff-acc').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = e.currentTarget.getAttribute('data-id');
        if (confirm('Are you sure you want to delete this staff login? The staff member will no longer be able to log into the staff portal.')) {
          window.SalonStore.deleteStaffAccount(id);
          renderStaffAccounts();
        }
      });
    });
  }

  function openStaffAccountModal(acc) {
    const modal = document.getElementById('create-staff-account-modal');
    const form = document.getElementById('staff-account-form');
    const title = document.getElementById('staff-modal-form-title');
    const select = document.getElementById('sa-staff-select');
    if (!modal || !form || !select) return;

    // Populate staff options from active team
    const activeTechs = activeTeam.filter(t => t.id !== 'any-available');
    select.innerHTML = activeTechs.map(t => `
      <option value="${t.id}" data-name="${t.name}">${t.name} (${t.role})</option>
    `).join('') + `<option value="other">Other / New Technician</option>`;

    if (acc) {
      title.textContent = `Edit Login: ${acc.name}`;
      document.getElementById('sa-id').value = acc.id;
      select.value = acc.staffId || '';
      document.getElementById('sa-username').value = acc.username;
      document.getElementById('sa-password').value = acc.password;
      document.getElementById('sa-role').value = acc.role || 'staff';
    } else {
      title.textContent = 'Create Staff Portal Login';
      form.reset();
      document.getElementById('sa-id').value = '';
      document.getElementById('sa-role').value = 'staff';
      document.getElementById('sa-password').value = 'staff123';
