            <span class="app-price">${app.price}</span>
            <span class="app-dur">(${app.duration})</span>
          </div>
          <div class="app-contact-row">
            <span>📞 <a href="tel:${app.clientPhone}">${app.clientPhone}</a></span>
            ${app.clientNotes ? `<p class="app-notes"><em>Note:</em> ${app.clientNotes}</p>` : ''}
