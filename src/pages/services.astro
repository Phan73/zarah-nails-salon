---
import BaseLayout from '../layouts/BaseLayout.astro';
import servicesData from '../data/services.json';
import salonInfo from '../data/salon-info.json';
import colorsData from '../data/colors.json';

const colorCategories = ['All Shades', 'BIAB & Nudes', 'Chrome & Shimmer', 'Reds & Berries', 'Velvet Cat-Eye', 'Modern Earth'];
---

<BaseLayout
  currentPath="/services"
  title="Services & Pricing Menu | Zarah Nails & Beauty Massey"
  description="Transparent pricing for manicures, pedicures, BIAB builder gel overlays, acrylic extensions, custom nail art, threading, waxing, and facials in Massey, Auckland."
>
  <script src="/js/salon-store.js" is:inline></script>

  <!-- Header -->
  <section class="page-intro-section">
    <div class="container text-center">
      <p class="eyebrow">Price Menu &amp; Color Bar</p>
      <h1>Treatments &amp; Transparent Pricing</h1>
      <p class="intro-description">
        Every service is carried out using medical-grade hygiene protocols, sanitized stainless steel implements, and premium non-toxic nail elixirs. Prices are in NZD with no hidden extras.
      </p>

      <!-- Category Filter Pills -->
      <div class="category-filter-pills" id="category-filters">
        <button class="filter-pill active" data-category="all">All Services</button>
        {servicesData.map((cat) => (
          <button class="filter-pill" data-category={cat.category}>
            {cat.category}
          </button>
        ))}
        <button class="filter-pill color-highlight-pill" data-category="Available Colors">
          🎨 Available Colors &amp; Finishes
        </button>
      </div>
    </div>
  </section>

  <!-- Service List Container -->
  <section class="section services-page-content">
    <div class="container" id="services-main-container">
      {servicesData.map((categoryGroup) => (
        <div class="category-block" data-category-group={categoryGroup.category}>
          <div class="category-block-header">
            <h2>{categoryGroup.category}</h2>
            <p class="category-block-desc">{categoryGroup.description}</p>
          </div>

          <div class="category-items-grid">
            {categoryGroup.items.map((item) => (
              <div class="menu-item-card" data-service-id={item.id}>
                <div class="menu-item-top">
                  <div>
                    <div class="menu-item-title-row">
                      <h3 class="menu-item-name">{item.name}</h3>
                      {item.popular && <span class="badge badge-gold">Popular Choice</span>}
                    </div>
                    <span class="menu-item-duration">Estimated time: {item.duration}</span>
                  </div>
                  <div class="menu-item-price-tag">
                    {item.priceDisplay}
                  </div>
                </div>

                <p class="menu-item-desc">{item.description}</p>

                <div class="menu-item-actions">
                  <a href={`/booking?service=${item.id}`} class="btn btn-primary btn-sm">
                    Book Service
                  </a>
                  <a href={`tel:${salonInfo.contact.phone.replace(/\s+/g, '')}`} class="btn btn-subtle btn-sm" title="Call to ask a question">
                    Call to Inquire
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      <!-- Available Colors & Finishes Section -->
      <div class="category-block" data-category-group="Available Colors" id="salon-colors-section">
        <div class="category-block-header color-section-header">
          <div>
            <h2>🎨 Studio Color Bar &amp; Available Finishes</h2>
            <p class="category-block-desc">
              Browse our curated collection of 200+ salon-grade gel, BIAB builder, chrome, and magnetic finishes in studio.
            </p>
          </div>
          <span class="badge badge-gold">200+ Studio Shades</span>
        </div>

        <!-- Color Sub-filter Pills -->
        <div class="color-filter-pills" id="color-sub-filters">
          {colorCategories.map((cat, idx) => (
            <button
              class={`color-pill ${idx === 0 ? 'active' : ''}`}
              data-color-cat={cat === 'All Shades' ? 'all' : cat}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- Color Swatch Grid -->
        <div class="color-swatches-grid" id="color-swatches-container">
          {colorsData.map((shade) => (
            <div class="color-card" data-category={shade.category}>
              <div class="color-swatch-wrap">
                <div
                  class="color-swatch-circle"
                  style={shade.isGradient ? `background: ${shade.gradient};` : `background-color: ${shade.colorHex};`}
                >
                  {shade.category === 'Chrome & Shimmer' && <span class="shimmer-glint">✨</span>}
                  {shade.category === 'Velvet Cat-Eye' && <span class="cat-eye-streak"></span>}
                </div>
                <span class="color-code">{shade.code}</span>
              </div>
              <div class="color-info">
                <h4 class="color-title">{shade.name}</h4>
                <span class="color-finish-badge">{shade.finish}</span>
                <p class="color-desc">{shade.description}</p>
                <div class="color-card-actions">
                  <a href={`/booking?service=${shade.serviceMatch || 'gel-manicure'}`} class="btn btn-primary btn-sm btn-block">
                    Book With This Color
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Color Bar Reassurance Banner -->
        <div class="color-reassurance-box">
          <div class="reassurance-icon">💡</div>
          <div class="reassurance-text">
            <h4>Have a Specific Shade or Inspiration Photo?</h4>
            <p>
              We stock the full professional ranges of <strong>The GelBottle (TGB)</strong>, <strong>OPI GelColor</strong>, <strong>DND</strong>, and <strong>Apres</strong>. If you saw a shade on Pinterest, Instagram, or TikTok, simply bring a screenshot to your appointment and our nail artists will match or custom blend it for you at no extra charge!
            </p>
          </div>
        </div>
      </div>

      <!-- Service Preparation & Aftercare Notice -->
      <div class="salon-prep-box">
        <div class="prep-icon">✨</div>
        <div class="prep-content">
          <h3>Preparation &amp; What to Expect</h3>
          <p>
            Please let us know in advance if you currently have existing acrylics, SNS, or foreign gel that requires removal so we can allocate sufficient time. We never rush removals to preserve your natural nail matrix.
          </p>
          <p class="prep-note">
            Need custom nail art? Feel free to save screenshots from Pinterest or Instagram and show them to your technician upon arrival!
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ initialServices: servicesData, salonPhone: salonInfo.contact.phone }}>
  // Dynamic hydration from Owner/Admin updates
  function hydrateDynamicServices() {
    if (!window.SalonStore) return;
    const storedServices = window.SalonStore.getServices(null);
    if (!storedServices || !Array.isArray(storedServices) || storedServices.length === 0) return; // Keep server-rendered HTML

    const container = document.getElementById('services-main-container');
    if (!container) return;

    const prepBox = container.querySelector('.salon-prep-box');
    const colorSection = document.getElementById('salon-colors-section');
    const existingBlocks = container.querySelectorAll('.category-block:not(#salon-colors-section)');
    existingBlocks.forEach(b => b.remove());

    storedServices.forEach(cat => {
      const block = document.createElement('div');
      block.className = 'category-block';
      block.setAttribute('data-category-group', cat.category);

      const itemsHtml = cat.items.map(item => `
        <div class="menu-item-card" data-service-id="${item.id}">
          <div class="menu-item-top">
            <div>
              <div class="menu-item-title-row">
                <h3 class="menu-item-name">${item.name}</h3>
                ${item.popular ? '<span class="badge badge-gold">Popular Choice</span>' : ''}
              </div>
              <span class="menu-item-duration">Estimated time: ${item.duration}</span>
            </div>
            <div class="menu-item-price-tag">
              ${item.priceDisplay}
            </div>
          </div>
          <p class="menu-item-desc">${item.description}</p>
          <div class="menu-item-actions">
            <a href="/booking?service=${item.id}" class="btn btn-primary btn-sm">
              Book Service
            </a>
            <a href="tel:${salonPhone.replace(/\s+/g, '')}" class="btn btn-subtle btn-sm">
              Call to Inquire
            </a>
          </div>
        </div>
      `).join('');

      block.innerHTML = `
        <div class="category-block-header">
          <h2>${cat.category}</h2>
          <p class="category-block-desc">${cat.description}</p>
        </div>
        <div class="category-items-grid">${itemsHtml}</div>
      `;

      if (colorSection) container.insertBefore(block, colorSection);
      else if (prepBox) container.insertBefore(block, prepBox);
      else container.appendChild(block);
    });

    bindFilterPills();
  }

  function bindFilterPills() {
    const filterPills = document.querySelectorAll('#category-filters .filter-pill');
    const categoryBlocks = document.querySelectorAll('.category-block');

    filterPills.forEach((pill) => {
      pill.onclick = () => {
        filterPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const selected = (pill.getAttribute('data-category') || 'all').toLowerCase();
        categoryBlocks.forEach((block) => {
          const blockCategory = (block.getAttribute('data-category-group') || '').toLowerCase();
          if (selected === 'all' || blockCategory === selected || blockCategory.includes(selected)) {
            block.style.display = 'block';
          } else {
            block.style.display = 'none';
          }
        });
      };
    });

    bindColorSubFilters();
  }

  function bindColorSubFilters() {
    const colorPills = document.querySelectorAll('#color-sub-filters .color-pill');
    const colorCards = document.querySelectorAll('.color-card');

    colorPills.forEach((pill) => {
      pill.onclick = () => {
        colorPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');

        const selectedCat = (pill.getAttribute('data-color-cat') || 'all').toLowerCase();
        colorCards.forEach((card) => {
          const cardCat = (card.getAttribute('data-category') || '').toLowerCase();
          if (selectedCat === 'all' || cardCat.includes(selectedCat)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      };
    });
  }

  function hydrateDynamicColors() {
    if (!window.SalonStore) return;
    const storedColors = window.SalonStore.getColors(null);
    if (!storedColors || !Array.isArray(storedColors) || storedColors.length === 0) return;

    const container = document.getElementById('color-swatches-container');
    if (!container) return;

    container.innerHTML = storedColors.map(shade => `
      <div class="color-card" data-category="${shade.category}">
        <div class="color-swatch-wrap">
          <div
            class="color-swatch-circle"
            style="${shade.isGradient ? `background: ${shade.gradient};` : `background-color: ${shade.colorHex};`}"
          >
            ${shade.category === 'Chrome & Shimmer' ? '<span class="shimmer-glint">✨</span>' : ''}
            ${shade.category === 'Velvet Cat-Eye' ? '<span class="cat-eye-streak"></span>' : ''}
          </div>
          <span class="color-code">${shade.code}</span>
        </div>
        <div class="color-info">
          <h4 class="color-title">${shade.name}</h4>
          <span class="color-finish-badge">${shade.finish}</span>
          <p class="color-desc">${shade.description}</p>
          <div class="color-card-actions">
            <a href="/booking?service=${shade.serviceMatch || 'gel-manicure'}" class="btn btn-primary btn-sm btn-block">
              Book With This Color
            </a>
          </div>
        </div>
      </div>
    `).join('');

    bindColorSubFilters();
  }

  document.addEventListener('DOMContentLoaded', () => {
    hydrateDynamicServices();
    hydrateDynamicColors();
    bindFilterPills();
  });
  window.addEventListener('zarah:services-updated', hydrateDynamicServices);
  window.addEventListener('zarah:colors-updated', hydrateDynamicColors);
</script>

<style>
  .page-intro-section {
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--border-delicate);
    padding: clamp(2.5rem, 5vw, 4rem) 0;
  }

  .intro-description {
    max-width: 650px;
    margin: 1rem auto 2rem auto;
    font-size: 1.05rem;
  }

  .text-center {
    text-align: center;
  }

  /* Filter Pills */
  .category-filter-pills {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .filter-pill {
    padding: 0.55rem 1.15rem;
    background-color: var(--bg-stone);
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-cocoa);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    background-color: var(--bg-stone-dark);
    color: var(--text-espresso);
  }

  .filter-pill.active {
    background-color: var(--text-espresso);
    color: #FAF8F5;
    border-color: var(--text-espresso);
  }

  /* Categories */
  .services-page-content {
    padding: 3.5rem 0;
  }

  .category-block {
    margin-bottom: 4rem;
  }

  .category-block-header {
    margin-bottom: 1.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-delicate);
  }

  .category-block-desc {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .category-items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 1.5rem;
  }

  .menu-item-card {
    background-color: #FFFFFF;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    box-shadow: var(--shadow-subtle);
  }

  .menu-item-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .menu-item-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .menu-item-name {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .menu-item-duration {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .menu-item-price-tag {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--accent-rose);
    white-space: nowrap;
  }

  .menu-item-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-cocoa);
  }

  .menu-item-actions {
    display: flex;
    gap: 0.75rem;
  }

  /* Prep Box */
  .salon-prep-box {
    margin-top: 4rem;
    background-color: #FFFFFF;
    border: 1px solid var(--gold-champagne);
    border-radius: var(--radius-md);
    padding: 2rem;
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    box-shadow: var(--shadow-card);
  }

  .prep-icon {
    font-size: 2rem;
  }

  .prep-content h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .prep-content p {
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .prep-note {
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--accent-rose);
  }

  /* Color Bar Styles */
  .color-highlight-pill {
    background: linear-gradient(135deg, #FEF3C7, #FDE68A);
    color: #92400E;
    border-color: #F59E0B;
  }

  .color-highlight-pill:hover,
  .color-highlight-pill.active {
    background: linear-gradient(135deg, #F59E0B, #D97706);
    color: #FFFFFF;
    border-color: #B45309;
  }

  .color-section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .color-filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 2rem 0;
  }

  .color-pill {
    padding: 0.4rem 0.95rem;
    background-color: var(--bg-stone);
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-cocoa);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .color-pill:hover {
    background-color: var(--bg-stone-dark);
    color: var(--text-espresso);
  }

  .color-pill.active {
    background-color: var(--text-espresso);
    color: #FAF8F5;
    border-color: var(--text-espresso);
  }

  .color-swatches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .color-card {
    background-color: #FFFFFF;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    box-shadow: var(--shadow-subtle);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .color-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .color-swatch-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .color-swatch-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 3px solid #FFFFFF;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12), inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .shimmer-glint {
    font-size: 0.9rem;
    animation: pulseGlint 2s infinite ease-in-out;
  }

  @keyframes pulseGlint {
    0%, 100% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  .cat-eye-streak {
    width: 6px;
    height: 120%;
    background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.85), transparent);
    transform: rotate(35deg);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
  }

  .color-code {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    background-color: var(--bg-stone);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .color-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .color-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-espresso);
    margin: 0;
  }

  .color-finish-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent-rose);
    background-color: var(--accent-rose-soft);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.25rem;
  }

  .color-desc {
    font-size: 0.84rem;
    color: var(--text-cocoa);
    line-height: 1.45;
    margin: 0 0 0.75rem 0;
    flex: 1;
  }

  .color-card-actions {
    margin-top: auto;
  }

  .color-reassurance-box {
    background-color: #FFFFFF;
    border: 1px solid var(--gold-champagne);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    box-shadow: var(--shadow-subtle);
  }

  .reassurance-icon {
    font-size: 1.75rem;
  }

  .reassurance-text h4 {
    font-size: 1.1rem;
    margin-bottom: 0.35rem;
    color: var(--text-espresso);
  }

  .reassurance-text p {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-cocoa);
    margin: 0;
  }

  @media (max-width: 640px) {
    .category-items-grid {
      grid-template-columns: 1fr;
    }
    .color-swatches-grid {
      grid-template-columns: 1fr;
    }
    .salon-prep-box,
    .color-reassurance-box {
      flex-direction: column;
    }
  }
</style>
