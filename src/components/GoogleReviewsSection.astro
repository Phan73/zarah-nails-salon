---
import initialGoogleReviews from '../data/google-reviews.json';

// Calculate summary stats
const validReviews = initialGoogleReviews.filter(r => (r.rating || 5) >= 4);
const avgRating = (validReviews.reduce((sum, r) => sum + r.rating, 0) / (validReviews.length || 1)).toFixed(1);
---

<section class="section google-reviews-section" id="google-reviews">
  <div class="container">
    <!-- Google Header Banner -->
    <div class="google-header-block">
      <div class="google-identity">
        <!-- Google G Logo SVG -->
        <div class="google-g-wrap" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
        </div>

        <div>
          <div class="google-rating-row">
            <span class="rating-number" id="google-avg-score">{avgRating}</span>
            <div class="stars-gold" aria-label={`${avgRating} out of 5 stars`}>
              ★★★★★
            </div>
            <span class="badge-verified">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="#3D6A52"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Google Verified
            </span>
          </div>
          <h2 class="reviews-main-title">Real Google Reviews</h2>
          <p class="reviews-subtitle">
            Authentic client ratings from our Google Maps listing in Massey, Auckland. Showing verified 4★ &amp; 5★ reviews only.
          </p>
        </div>
      </div>

      <div class="google-cta-actions">
        <a
          href="https://www.google.com/search?q=zara+nail+massey"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-subtle btn-sm"
          title="Open Google to leave a salon review"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
          <span>Write a Google Review</span>
        </a>
        <a
          href="https://www.google.com/search?q=zara+nail+massey"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-sm"
        >
          <span>View on Google Maps &rarr;</span>
        </a>
      </div>
    </div>

    <!-- Live Filter & Count Bar -->
    <div class="reviews-filter-bar">
      <div class="filter-indicator">
        <span class="live-dot"></span>
        <span id="reviews-live-count">Displaying {validReviews.length} Verified Reviews</span>
      </div>
      <span class="filter-pill">⭐ 4.0+ Stars Only • Most Recent First</span>
    </div>

    <!-- Reviews Grid -->
    <div class="google-reviews-grid" id="google-reviews-container">
      {validReviews.map((rev) => (
        <div class="google-review-card" data-rating={rev.rating}>
          <div class="card-top">
            <div class="reviewer-meta">
              <img
                src={rev.profile_photo_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(rev.author_name)}&background=C48B71&color=fff&size=80`}
                alt={rev.author_name}
                class="reviewer-avatar"
                loading="lazy"
                width="44"
                height="44"
              />
              <div>
                <div class="reviewer-name-line">
                  <strong>{rev.author_name}</strong>
                  <span class="g-check-icon" title="Verified Google Maps Reviewer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="#4285F4"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                  </span>
                </div>
                <span class="review-date-label">{rev.relative_time_description}</span>
              </div>
            </div>

            <!-- Google G Icon on Card -->
            <div class="card-g-icon" title="Google Review">
              <svg width="18" height="18" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
            </div>
          </div>

          <!-- Stars -->
          <div class="card-stars-row">
            <span class="stars-gold-compact">
              {'★'.repeat(rev.rating)}
              {'☆'.repeat(5 - rev.rating)}
            </span>
            <span class="card-rating-num">{rev.rating}.0</span>
          </div>

          <!-- Review Content -->
          <p class="google-review-text">"{rev.text}"</p>

          <!-- Footer with Service Tag -->
          <div class="card-footer-service">
            <span class="service-pill">💅 {rev.service}</span>
            <a
              href="https://www.google.com/search?q=zara+nail+massey"
              target="_blank"
              rel="noopener noreferrer"
              class="verify-link"
            >
              Verify on Google &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Client-side Hydration & Auto-Update Listener -->
<script is:inline define:vars={{ initialGoogleReviews }}>
  (function() {
    function renderLiveGoogleReviews() {
      var container = document.getElementById('google-reviews-container');
      if (!container) return;

      var reviews = window.SalonStore 
        ? window.SalonStore.getGoogleReviews(initialGoogleReviews)
        : initialGoogleReviews;

      // Filter for 4+ stars only and sort most recent
      var valid = reviews
        .filter(function(r) { return (parseFloat(r.rating) || 5) >= 4; })
        .sort(function(a, b) { return (b.timestamp || 0) - (a.timestamp || 0); });

      var countEl = document.getElementById('reviews-live-count');
      if (countEl) countEl.textContent = 'Displaying ' + valid.length + ' Verified Reviews';

      var scoreEl = document.getElementById('google-avg-score');
      if (scoreEl && valid.length > 0) {
        var total = valid.reduce(function(sum, r) { return sum + (parseFloat(r.rating) || 5); }, 0);
        scoreEl.textContent = (total / valid.length).toFixed(1);
      }

      container.innerHTML = valid.map(function(rev) {
        var starGold = '★'.repeat(rev.rating) + '☆'.repeat(5 - rev.rating);
        var avatar = rev.profile_photo_url || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(rev.author_name) + '&background=C48B71&color=fff&size=80');

        return [
          '<div class="google-review-card" data-rating="' + rev.rating + '">',
            '<div class="card-top">',
              '<div class="reviewer-meta">',
                '<img src="' + avatar + '" alt="' + rev.author_name + '" class="reviewer-avatar" loading="lazy" width="44" height="44" />',
                '<div>',
                  '<div class="reviewer-name-line">',
                    '<strong>' + rev.author_name + '</strong>',
                    '<span class="g-check-icon" title="Verified Google Reviewer">',
                      '<svg width="14" height="14" viewBox="0 0 24 24" fill="#4285F4"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>',
                    '</span>',
                  '</div>',
                  '<span class="review-date-label">' + (rev.relative_time_description || 'Recently') + '</span>',
                '</div>',
              '</div>',
              '<div class="card-g-icon" title="Google Review">',
                '<svg width="18" height="18" viewBox="0 0 24 24">',
                  '<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>',
                  '<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>',
                  '<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>',
                  '<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>',
                '</svg>',
              '</div>',
            '</div>',
            '<div class="card-stars-row">',
              '<span class="stars-gold-compact">' + starGold + '</span>',
              '<span class="card-rating-num">' + rev.rating + '.0</span>',
            '</div>',
            '<p class="google-review-text">"' + rev.text + '"</p>',
            '<div class="card-footer-service">',
              '<span class="service-pill">💅 ' + (rev.service || 'Nail Treatment') + '</span>',
              '<a href="https://www.google.com/search?q=zara+nail+massey" target="_blank" rel="noopener noreferrer" class="verify-link">',
                'Verify on Google &rarr;',
              '</a>',
            '</div>',
          '</div>'
        ].join('');
      }).join('');
    }

    document.addEventListener('DOMContentLoaded', renderLiveGoogleReviews);
    window.addEventListener('zarah:google-reviews-updated', renderLiveGoogleReviews);
  })();
</script>

<style>
  .google-reviews-section {
    background-color: var(--bg-porcelain);
    border-top: 1px solid var(--border-delicate);
    padding: 5rem 0;
  }

  .google-header-block {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .google-identity {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 680px;
  }

  .google-g-wrap {
    background: #FFFFFF;
    border: 1px solid var(--border-delicate);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .google-rating-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }

  .rating-number {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-espresso);
    letter-spacing: -0.02em;
  }

  .stars-gold {
    color: #F4B400;
    font-size: 1.2rem;
    letter-spacing: 0.15em;
  }

  .badge-verified {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #2D503D;
    background-color: #EBF3EE;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }

  .reviews-main-title {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    color: var(--text-espresso);
    margin: 0.2rem 0 0.5rem 0;
    line-height: 1.2;
  }

  .reviews-subtitle {
    font-size: 0.95rem;
    color: var(--text-cocoa);
    line-height: 1.5;
    margin: 0;
  }

  .google-cta-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .reviews-filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    background: #FFFFFF;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-sm);
    margin-bottom: 2rem;
    font-size: 0.85rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .filter-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-espresso);
    font-weight: 500;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background-color: #3D6A52;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(61, 106, 82, 0.2);
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.9); }
  }

  .filter-pill {
    background-color: var(--bg-porcelain);
    color: var(--text-espresso);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    border: 1px solid var(--border-delicate);
  }

  /* Grid */
  .google-reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .google-review-card {
    background-color: #FFFFFF;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    box-shadow: var(--shadow-subtle);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--transition-medium), box-shadow var(--transition-medium);
  }

  .google-review-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -10px rgba(36, 30, 28, 0.12);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.85rem;
  }

  .reviewer-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .reviewer-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--bg-porcelain);
  }

  .reviewer-name-line {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    color: var(--text-espresso);
  }

  .g-check-icon {
    display: inline-flex;
    align-items: center;
  }

  .review-date-label {
    display: block;
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  .card-g-icon {
    opacity: 0.85;
    flex-shrink: 0;
  }

  .card-stars-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .stars-gold-compact {
    color: #F4B400;
    font-size: 1rem;
    letter-spacing: 0.1em;
  }

  .card-rating-num {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-cocoa);
  }

  .google-review-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-espresso);
    margin: 0 0 1.25rem 0;
    flex: 1;
    font-style: normal;
  }

  .card-footer-service {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border-delicate);
    font-size: 0.78rem;
  }

  .service-pill {
    background-color: var(--bg-porcelain);
    color: var(--text-espresso);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .verify-link {
    color: var(--accent-rose);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .verify-link:hover {
    color: var(--text-espresso);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .google-header-block {
      flex-direction: column;
      align-items: flex-start;
    }
    .reviews-main-title {
      font-size: 1.8rem;
    }
    .google-reviews-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
