---
import Logo from './Logo.astro';
import salonInfo from '../data/salon-info.json';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services & Pricing' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Location & Hours' },
  { href: '/policies', label: 'Policies' },
];
---

<header class="site-header">
  <!-- Top Utility Bar -->
  <div class="top-announcement-bar">
    <div class="container top-bar-content">
      <div class="top-bar-item location">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span>Shop 12, 3 Red Hills Rd, Massey, Auckland</span>
      </div>
      <div class="top-bar-right">
        <div class="top-bar-item hours">
          <span class="open-dot" aria-hidden="true"></span>
          <span>Open Today • Walk-ins &amp; Bookings</span>
        </div>
        <a href={`tel:${salonInfo.contact.phone.replace(/\s+/g, '')}`} class="top-bar-item phone-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span>{salonInfo.contact.phoneDisplay}</span>
        </a>
        <button type="button" class="customer-auth-trigger top-bar-item customer-pass-pill" title="Sign In (Customer, Staff & Admin)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span>Login</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="nav-container">
    <div class="container nav-content">
      <a href="/" class="brand-link">
        <Logo variant="horizontal" />
      </a>

      <!-- Desktop Nav -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`nav-link ${currentPath === link.href ? 'active' : ''}`}
                aria-current={currentPath === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Desktop CTA Actions -->
      <div class="nav-actions">
        <button type="button" class="customer-auth-trigger btn btn-subtle nav-client-pass-btn" title="Sign In (Customer, Staff & Admin)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span>Login</span>
        </button>
        <a href="/booking" class="btn btn-primary nav-book-btn">
          Book Appointment
        </a>
      </div>

      <!-- Mobile Hamburger Toggle -->
      <button
        type="button"
        class="mobile-menu-toggle"
        id="menu-toggle-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <div class="mobile-drawer-header">
        <Logo variant="compact" />
        <button type="button" class="close-drawer-btn" id="close-drawer-btn" aria-label="Close menu">
          &times;
        </button>
      </div>

      <nav class="mobile-nav" aria-label="Mobile Navigation">
        <ul class="mobile-nav-list">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`mobile-nav-link ${currentPath === link.href ? 'active' : ''}`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mobile-drawer-footer">
        <button type="button" class="customer-auth-trigger btn btn-subtle btn-block mobile-client-btn" style="margin-bottom: 0.65rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span>Login</span>
        </button>
        <a href="/booking" class="btn btn-primary btn-block">
          Book Appointment
        </a>
        <a href={`tel:${salonInfo.contact.phone.replace(/\s+/g, '')}`} class="btn btn-subtle btn-block call-btn">
          Call Salon: {salonInfo.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const closeBtn = document.getElementById('close-drawer-btn');
  const drawer = document.getElementById('mobile-nav-drawer');

  function openMenu() {
    if (!drawer || !toggleBtn) return;
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    toggleBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!drawer || !toggleBtn) return;
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    toggleBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggleBtn?.addEventListener('click', () => {
    const isOpen = drawer?.classList.contains('is-open');
    if (isOpen) closeMenu();
    else openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);

  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) closeMenu();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
      closeMenu();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    background-color: var(--bg-porcelain);
    border-bottom: 1px solid var(--border-delicate);
  }

  /* Top Bar */
  .top-announcement-bar {
    background-color: var(--text-espresso);
    color: var(--bg-porcelain);
    font-size: 0.78rem;
    padding: 0.45rem 0;
    letter-spacing: 0.02em;
  }

  .top-bar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .top-bar-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .top-bar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .open-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #68D391;
    display: inline-block;
  }

  .phone-link {
    color: var(--gold-champagne-light);
    font-weight: 600;
  }
  .phone-link:hover {
    color: #FFFFFF;
  }

  .staff-portal-pill {
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.12);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--bg-stone);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .staff-portal-pill:hover {
    background-color: var(--accent-rose);
    border-color: var(--accent-rose);
    color: #FFFFFF;
  }

  .customer-pass-pill {
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.08);
    font-size: 0.72rem;
    font-weight: 600;
    color: #FAF8F5;
    border: 1px solid rgba(255, 255, 255, 0.18);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .customer-pass-pill:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
  }
  .customer-pass-pill.logged-in {
    background-color: rgba(52, 211, 153, 0.2);
    border-color: rgba(52, 211, 153, 0.4);
    color: #A7F3D0;
  }
  .customer-pass-pill.reward-available {
    background-color: rgba(245, 158, 11, 0.25);
    border-color: #F59E0B;
    color: #FDE68A;
    animation: goldGlow 2s infinite alternate;
  }

  .nav-client-pass-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-sm);
  }

  .nav-client-pass-btn.logged-in {
    background-color: #EFF7F2;
    border-color: #34D399;
    color: #065F46;
    font-weight: 600;
  }

  .nav-client-pass-btn.reward-available {
    background: linear-gradient(135deg, #FEF3C7, #FDE68A);
    border-color: #F59E0B;
    color: #92400E;
    animation: goldGlow 2s infinite alternate;
  }

  .user-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
  .user-dot.green {
    background-color: #10B981;
  }
  .user-dot.gold {
    background-color: #F59E0B;
    box-shadow: 0 0 6px #F59E0B;
  }

  .user-name {
    font-weight: 700;
  }

  .user-dots-summary {
    font-size: 0.75rem;
    opacity: 0.85;
  }

  /* Main Nav */
  .nav-container {
    background-color: rgba(250, 248, 245, 0.96);
    backdrop-filter: blur(10px);
    width: 100%;
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.65rem;
    padding-bottom: 0.65rem;
    gap: clamp(0.75rem, 1.5vw, 1.75rem);
    flex-wrap: nowrap; /* Ensures navbar items NEVER wrap onto multiple vertical lines */
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    line-height: 1;
  }

  .brand-link :global(.logo-svg) {
    height: 40px;
    width: auto;
    display: block;
    max-width: 250px;
  }

  .desktop-nav {
    display: none;
    flex: 1 1 auto;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    justify-content: center;
    list-style: none;
    gap: clamp(0.65rem, 1.3vw, 1.5rem);
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-cocoa);
    position: relative;
    padding: 0.35rem 0;
    white-space: nowrap; /* Prevents text from breaking into 2 lines */
    transition: color var(--transition-fast);
  }

  .nav-link:hover, .nav-link.active {
    color: var(--text-espresso);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--accent-rose);
  }

  /* Right CTA Action Area - Single Horizontal Line */
  .nav-actions {
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 0.65rem;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .nav-book-btn {
    padding: 0.55rem 1.2rem;
    font-size: 0.86rem;
    white-space: nowrap;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 38px;
    height: 38px;
    padding: 8px 6px;
    background: transparent;
    border: 1px solid var(--border-delicate);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--text-espresso);
    border-radius: 2px;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    background-color: rgba(36, 30, 28, 0.6);
    backdrop-filter: blur(4px);
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-smooth), visibility var(--transition-smooth);
  }

  .mobile-drawer.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-drawer-inner {
    position: absolute;
    top: 0;
    right: 0;
    width: min(85vw, 360px);
    height: 100%;
    background-color: var(--bg-porcelain);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-modal);
    transform: translateX(100%);
    transition: transform var(--transition-smooth);
    overflow-y: auto;
  }

  .mobile-drawer.is-open .mobile-drawer-inner {
    transform: translateX(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-delicate);
  }

  .close-drawer-btn {
    background: transparent;
    border: none;
    font-size: 2rem;
    line-height: 1;
    color: var(--text-espresso);
    cursor: pointer;
    padding: 0.25rem;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.65rem 0.5rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-espresso);
    border-radius: var(--radius-sm);
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    background-color: var(--bg-stone);
    color: var(--accent-rose);
  }

  .mobile-staff-divider {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-delicate);
  }

  .mobile-nav-link.staff-link {
    color: var(--gold-champagne-dark);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .mobile-drawer-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-delicate);
  }

  .btn-block {
    width: 100%;
  }

  @media (min-width: 960px) {
    .desktop-nav {
      display: flex;
    }
    .mobile-menu-toggle {
      display: none;
    }
  }

  @media (max-width: 1180px) {
    .nav-list {
      gap: 0.75rem;
    }
    .nav-link {
      font-size: 0.84rem;
    }
    .nav-book-btn {
      padding: 0.48rem 0.95rem;
      font-size: 0.82rem;
    }
    .nav-client-pass-btn {
      padding: 0.42rem 0.65rem;
      font-size: 0.78rem;
    }
    .brand-link :global(.logo-svg) {
      height: 36px;
    }
  }

  @media (max-width: 959px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu-toggle {
      display: flex;
    }
    .nav-actions .nav-client-pass-btn {
      display: none; /* Login is in top announcement bar & mobile drawer */
    }
    .nav-book-btn {
      padding: 0.45rem 0.85rem;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 720px) {
    .top-bar-item.location {
      display: none;
    }
    .top-bar-content {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .brand-link :global(.logo-svg) {
      height: 32px;
      max-width: 180px;
    }
    .nav-book-btn {
      padding: 0.38rem 0.65rem;
      font-size: 0.75rem;
    }
  }
</style>
