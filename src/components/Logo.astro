---
interface Props {
  variant?: 'horizontal' | 'compact' | 'mark';
  class?: string;
  theme?: 'dark' | 'light';
}

const { variant = 'horizontal', class: className = '', theme = 'light' } = Astro.props;
const isDark = theme === 'dark';
const primaryText = isDark ? '#FAF8F5' : '#241E1C';
const secondaryText = isDark ? '#DFD8D3' : '#7A6B63';
const subText = isDark ? '#B8ABA4' : '#A6948A';
---

<div class={`salon-logo-wrapper ${className}`} aria-label="Zarah Nails & Beauty">
  {variant === 'horizontal' && (
    <svg viewBox="0 0 460 76" class="logo-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="logoGoldH" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#D4AF37" />
          <stop offset="50%" stop-color="#C5A880" />
          <stop offset="100%" stop-color="#A5865E" />
        </linearGradient>
        <linearGradient id="logoRoseH" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#E8C5B8" />
          <stop offset="100%" stop-color="#B58A7E" />
        </linearGradient>
      </defs>

      <!-- Monogram -->
      <g transform="translate(4, 2)">
        <circle cx="36" cy="36" r="34" stroke="url(#logoGoldH)" stroke-width="1.2" stroke-dasharray="3 2" opacity="0.65"/>
        <path d="M 24 22 L 48 22 C 49.5 22 50 23 49 24.5 L 25 47 C 24 48 25 49 27 49 L 49 49" 
              stroke={primaryText} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M 30 18 C 44 18 54 28 54 42 C 54 50 48 55 42 55" 
              stroke="url(#logoRoseH)" stroke-width="2" stroke-linecap="round"/>
        <path d="M 48 20 Q 48 24 52 24 Q 48 24 48 28 Q 48 24 44 24 Q 48 24 48 20 Z" fill="url(#logoGoldH)"/>
      </g>

      <!-- Brand Typography -->
      <text x="86" y="42" font-family="'Playfair Display', Georgia, serif" font-size="32" font-weight="600" letter-spacing="4" fill={primaryText}>
        ZARAH
      </text>

      <line x1="88" y1="50" x2="440" y2="50" stroke="url(#logoGoldH)" stroke-width="0.8" opacity="0.8"/>

      <text x="89" y="66" font-family="'Plus Jakarta Sans', sans-serif" font-size="9.5" font-weight="600" letter-spacing="4.5" fill={secondaryText}>
        NAILS &amp; BEAUTY
      </text>
      <text x="310" y="66" font-family="'Plus Jakarta Sans', sans-serif" font-size="8.5" font-weight="500" letter-spacing="2.5" fill={subText}>
        MASSEY • AUCKLAND
      </text>
    </svg>
  )}

  {variant === 'compact' && (
    <svg viewBox="0 0 240 54" class="logo-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="logoGoldC" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#D4AF37" />
          <stop offset="100%" stop-color="#A5865E" />
        </linearGradient>
      </defs>
      <circle cx="26" cy="27" r="23" stroke="url(#logoGoldC)" stroke-width="1.2" opacity="0.7"/>
      <path d="M 18 16 L 34 16 L 19 36 L 35 36" stroke={primaryText} stroke-width="2.2" stroke-linecap="round"/>
      <text x="60" y="31" font-family="'Playfair Display', serif" font-size="24" font-weight="600" letter-spacing="3" fill={primaryText}>
        ZARAH
      </text>
      <text x="61" y="46" font-family="'Plus Jakarta Sans', sans-serif" font-size="7.5" font-weight="600" letter-spacing="3" fill={secondaryText}>
        NAILS &amp; BEAUTY
      </text>
    </svg>
  )}

  {variant === 'mark' && (
    <svg viewBox="0 0 60 60" class="logo-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="30" cy="30" r="28" stroke="#C5A880" stroke-width="1.5" stroke-dasharray="3 2" opacity="0.8"/>
      <path d="M 20 18 L 40 18 L 22 42 L 42 42" stroke={primaryText} stroke-width="2.8" stroke-linecap="round"/>
    </svg>
  )}
</div>

<style>
  .salon-logo-wrapper {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }
  .logo-svg {
    height: 48px;
    width: auto;
    display: block;
  }
  @media (max-width: 640px) {
    .logo-svg {
      height: 40px;
    }
  }
</style>
